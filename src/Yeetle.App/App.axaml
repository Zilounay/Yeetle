<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yeetle.App.App"
             xmlns:suki="clr-namespace:SukiUI;assembly=SukiUI"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- Icons come from Windows' own icon font: Segoe Fluent Icons on Windows 11, the older
             Segoe MDL2 Assets on Windows 10, which has the same code points. -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <x:String x:Key="IconPlay">&#xE768;</x:String>
        <x:String x:Key="IconPause">&#xE769;</x:String>
        <x:String x:Key="IconPrevious">&#xE892;</x:String>
        <x:String x:Key="IconNext">&#xE893;</x:String>
        <x:String x:Key="IconUndo">&#xE7A7;</x:String>
        <x:String x:Key="IconMarker">&#xE7C1;</x:String>
        <x:String x:Key="IconVolume">&#xE767;</x:String>
        <x:String x:Key="IconMute">&#xE74F;</x:String>
        <x:String x:Key="IconTheatre">&#xE740;</x:String>
        <x:String x:Key="IconAudioTrack">&#xE8D6;</x:String>
        <x:String x:Key="IconAudioOutput">&#xE7F5;</x:String>
        <x:String x:Key="IconSearch">&#xE721;</x:String>
        <x:String x:Key="IconFolder">&#xE838;</x:String>
        <x:String x:Key="IconRescan">&#xE72C;</x:String>
        <x:String x:Key="IconTag">&#xE8EC;</x:String>
        <x:String x:Key="IconSettings">&#xE713;</x:String>
        <x:String x:Key="IconStop">&#xE71A;</x:String>
        <x:String x:Key="IconCheck">&#xE73E;</x:String>
        <x:String x:Key="IconClose">&#xE711;</x:String>
        <x:String x:Key="IconForward">&#xE72A;</x:String>
        <x:String x:Key="IconAdd">&#xE710;</x:String>
        <x:String x:Key="IconWarning">&#xE7BA;</x:String>
        <x:String x:Key="IconVideo">&#xE714;</x:String>
        <x:String x:Key="IconHistory">&#xE81C;</x:String>
        <x:String x:Key="IconCarried">&#xE8EE;</x:String>
    </Application.Resources>
    <Application.Styles>
        <!-- SukiUI underneath (#69); its colour theme is set by Theming/Appearance.cs. The Yeetle look
             on top: colours, cards and controls from ZiL's canvas. -->
        <suki:SukiTheme ThemeColor="Blue" />
        <StyleInclude Source="avares://Yeetle.App/Theming/YeetleTheme.axaml" />
    </Application.Styles>
</Application>
