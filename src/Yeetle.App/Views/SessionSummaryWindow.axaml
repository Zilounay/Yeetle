<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yeetle.App.ViewModels"
        xmlns:res="using:Yeetle.App.Resources"
        x:Class="Yeetle.App.Views.SessionSummaryWindow"
        x:DataType="vm:SessionSummaryViewModel"
        Title="{res:Tr SessionSummaryTitle}"
        Width="760" Height="640" MinWidth="560" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark" Classes="dialog">
    <!-- Layout decided in #9, lists simplified in #62 (spec §5): count cards, a list per category,
         then Discard or Commit. -->
    <Window.Styles>
        <!-- The four counts (#9): a tinted tile each, the number large. -->
        <Style Selector="Border.count">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{StaticResource YtSkipSoftBrush}" />
        </Style>
        <Style Selector="TextBlock.number">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.category">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Styles>

    <!-- One file per line in smaller text; its tags and markers show on hover (#62). -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:SummaryClipViewModel" x:DataType="vm:SummaryClipViewModel">
            <TextBlock FontSize="13" Foreground="#D6D9E2" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Margin="0,3"
                       ToolTip.Tip="{Binding Details}" />
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,20">
            <TextBlock Classes="h1" Text="{res:Tr SessionSummaryTitle}" />
            <TextBlock Classes="hint" FontSize="15" Text="{res:Tr SessionSummaryHint}" />
        </StackPanel>

        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,20">
            <Border Classes="count" Background="{DynamicResource YtRowSelectedBrush}">
                <StackPanel>
                    <TextBlock Classes="number" Text="{Binding Reviewed}" />
                    <TextBlock FontSize="13" Foreground="{DynamicResource YtTagPillTextBrush}" Text="{res:Tr ReviewedLabel}" />
                </StackPanel>
            </Border>
            <Border Classes="count" Background="{StaticResource YtKeepSoftBrush}">
                <StackPanel>
                    <TextBlock Classes="number" Foreground="{StaticResource YtKeepTextBrush}" Text="{Binding KeptCount}" />
                    <TextBlock FontSize="13" Classes="secondary" Text="{res:Tr KeptLabel}" />
                </StackPanel>
            </Border>
            <Border Classes="count" Background="{StaticResource YtYeetSoftBrush}">
                <StackPanel>
                    <TextBlock Classes="number" Foreground="{StaticResource YtYeetTextBrush}" Text="{Binding YeetedCount}" />
                    <TextBlock FontSize="13" Classes="secondary" Text="{res:Tr YeetedLabel}" />
                </StackPanel>
            </Border>
            <Border Classes="count" Margin="0">
                <StackPanel>
                    <TextBlock Classes="number" Text="{Binding SkippedCount}" />
                    <TextBlock FontSize="13" Classes="secondary" Text="{res:Tr SkippedLabel}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,20,0,0">
            <Button x:Name="BackButton" Classes="link" Content="{res:Tr BackToSession}" IsCancel="True" />
            <Button x:Name="DiscardButton" Grid.Column="2" Classes="ghost large" Content="{res:Tr DiscardSession}" />
            <Button x:Name="CommitButton" Grid.Column="3" Classes="primary large" Content="{Binding CommitLabel}" IsDefault="True" />
        </Grid>

        <ScrollViewer>
            <StackPanel Spacing="16">
                <StackPanel Spacing="4" IsVisible="{Binding HasKept}">
                    <TextBlock Classes="category" Foreground="{StaticResource YtKeepTextBrush}" Text="{Binding KeptTitle}" />
                    <ItemsControl ItemsSource="{Binding Kept}" />
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding HasYeeted}">
                    <TextBlock Classes="category" Foreground="{StaticResource YtYeetTextBrush}" Text="{Binding YeetedTitle}" />
                    <ItemsControl ItemsSource="{Binding Yeeted}" />
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding HasSkipped}">
                    <TextBlock Classes="category" Text="{Binding SkippedTitle}" />
                    <ItemsControl ItemsSource="{Binding Skipped}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
