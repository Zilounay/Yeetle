<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yeetle.App.ViewModels"
        xmlns:res="using:Yeetle.App.Resources"
        x:Class="Yeetle.App.Views.SessionSummaryWindow"
        x:DataType="vm:SessionSummaryViewModel"
        Title="{x:Static res:Strings.SessionSummaryTitle}"
        Width="760" Height="640" MinWidth="560" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark" Background="#0E1013">
    <!-- Layout decided in #9, lists simplified in #62 (spec §5): count cards, a list per category,
         then Discard or Commit. -->
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#15181D" />
        <SolidColorBrush x:Key="KeepBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="YeetBrush" Color="#C62828" />
        <SolidColorBrush x:Key="SkipBrush" Color="#37474F" />
        <x:Double x:Key="SecondaryTextOpacity">0.7</x:Double>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.count">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
        </Style>
        <Style Selector="TextBlock.number">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Opacity" Value="{StaticResource SecondaryTextOpacity}" />
        </Style>
        <Style Selector="TextBlock.category">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.commit /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KeepBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <!-- One file per line in smaller text; its tags and markers show on hover (#62). -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:SummaryClipViewModel" x:DataType="vm:SummaryClipViewModel">
            <TextBlock FontSize="13" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Margin="0,1"
                       ToolTip.Tip="{Binding Details}" />
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock FontSize="20" FontWeight="Bold" Text="{x:Static res:Strings.SessionSummaryTitle}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.SessionSummaryHint}" />
        </StackPanel>

        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
            <Border Classes="count">
                <StackPanel>
                    <TextBlock Classes="number" Text="{Binding Reviewed}" />
                    <TextBlock Classes="secondary" Text="{x:Static res:Strings.ReviewedLabel}" />
                </StackPanel>
            </Border>
            <Border Classes="count" BorderBrush="{StaticResource KeepBrush}">
                <StackPanel>
                    <TextBlock Classes="number" Text="{Binding KeptCount}" />
                    <TextBlock Classes="secondary" Text="{x:Static res:Strings.KeptLabel}" />
                </StackPanel>
            </Border>
            <Border Classes="count" BorderBrush="{StaticResource YeetBrush}">
                <StackPanel>
                    <TextBlock Classes="number" Text="{Binding YeetedCount}" />
                    <TextBlock Classes="secondary" Text="{x:Static res:Strings.YeetedLabel}" />
                </StackPanel>
            </Border>
            <Border Classes="count" BorderBrush="{StaticResource SkipBrush}" Margin="0">
                <StackPanel>
                    <TextBlock Classes="number" Text="{Binding SkippedCount}" />
                    <TextBlock Classes="secondary" Text="{x:Static res:Strings.SkippedLabel}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,16,0,0">
            <Button x:Name="BackButton" Content="{x:Static res:Strings.BackToSession}" IsCancel="True" />
            <Button x:Name="DiscardButton" Grid.Column="2" Content="{x:Static res:Strings.DiscardSession}" />
            <Button x:Name="CommitButton" Grid.Column="3" Classes="commit" Content="{Binding CommitLabel}" IsDefault="True" />
        </Grid>

        <ScrollViewer>
            <StackPanel Spacing="16">
                <StackPanel Spacing="4" IsVisible="{Binding HasKept}">
                    <TextBlock Classes="category" Text="{Binding KeptTitle}" />
                    <ItemsControl ItemsSource="{Binding Kept}" />
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding HasYeeted}">
                    <TextBlock Classes="category" Text="{Binding YeetedTitle}" />
                    <ItemsControl ItemsSource="{Binding Yeeted}" />
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding HasSkipped}">
                    <TextBlock Classes="category" Text="{Binding SkippedTitle}" />
                    <ItemsControl ItemsSource="{Binding Skipped}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
