<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yeetle.App.ViewModels"
             xmlns:res="using:Yeetle.App.Resources"
             x:Class="Yeetle.App.Views.TagsPanel"
             x:DataType="vm:TagPanelViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WarningBackBrush" Color="#14EF5B5B" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.chip">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Button.chip TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.boxTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#E3E5EC" />
        </Style>
    </UserControl.Styles>

    <Border Classes="glass">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <TextBlock Classes="h2" VerticalAlignment="Center" Text="{res:Tr Tags}" />
                <Button Grid.Column="1" Classes="ghost small" Command="{Binding OpenTypeTagCommand}" ToolTip.Tip="{res:Tr TypeTagTip}"
                        AutomationProperties.Name="{res:Tr TypeTag}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" FontSize="14" Text="{StaticResource IconSearch}" />
                        <TextBlock Text="{res:Tr TypeTag}" VerticalAlignment="Center" />
                        <Border Classes="key"><TextBlock Text="T" /></Border>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- T: type-to-tag with path suggestions (spec §6). Hotkeys pause while typing. -->
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12" IsVisible="{Binding IsTyping}">
                <TextBox x:Name="TypedBox" Text="{Binding TypedText}" PlaceholderText="{res:Tr TypeTagWatermark}" />
                <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}" MaxHeight="220"
                         Focusable="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagSuggestion">
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="{StaticResource YtDangerTextBrush}"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock DockPanel.Dock="Top" Text="{res:Tr NoTagsYet}" TextWrapping="Wrap"
                       Classes="hint" IsVisible="{Binding IsEmpty}" />

            <TextBlock DockPanel.Dock="Bottom" Classes="muted" TextWrapping="Wrap"
                       Margin="0,10,0,0" Text="{res:Tr CarriedOverHint}" IsVisible="{Binding HasCarriedOver}" />

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChipGroupViewModel">
                            <Border Margin="0,0,0,8" Padding="0,4" CornerRadius="12" BorderThickness="1"
                                    BorderBrush="Transparent" Classes.warning="{Binding ShowRequiredWarning}">
                                <Border.Styles>
                                    <Style Selector="Border.warning">
                                        <Setter Property="BorderBrush" Value="{StaticResource YtDangerBorderBrush}" />
                                        <Setter Property="Background" Value="{StaticResource WarningBackBrush}" />
                                        <Setter Property="Padding" Value="10,8" />
                                    </Style>
                                </Border.Styles>
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="boxTitle" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Chips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChipViewModel">
                                                <Button Classes="chip" Classes.selected="{Binding IsSelected}"
                                                        Classes.carried="{Binding IsCarriedOver}" Command="{Binding Toggle}"
                                                        AutomationProperties.Name="{Binding Name}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Classes="icon" FontSize="12" Text="{StaticResource IconCarried}" IsVisible="{Binding IsCarriedOver}" />
                                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                                 Fill="{Binding ColourBrush}" IsVisible="{Binding HasColour}" />
                                                        <TextBlock Text="{Binding Name}" />
                                                        <Border Classes="key" Background="Transparent" Padding="0" IsVisible="{Binding HasHotkey}">
                                                            <TextBlock Opacity="0.7" Text="{Binding Hotkey}" />
                                                        </Border>
                                                        <TextBlock Text="×" IsVisible="{Binding IsCarriedOver}"
                                                                   ToolTip.Tip="{res:Tr RemoveTagTip}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock FontSize="12" Foreground="{StaticResource YtDangerTextBrush}" TextWrapping="Wrap"
                                               Text="{res:Tr RequiredBoxEmpty}" IsVisible="{Binding ShowRequiredWarning}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
