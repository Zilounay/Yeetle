<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yeetle.App.ViewModels"
        xmlns:res="using:Yeetle.App.Resources"
        x:Class="Yeetle.App.Views.RecoveryWindow"
        x:DataType="vm:RecoveryViewModel"
        Width="640" Height="520"
        WindowStartupLocation="CenterScreen"
        Title="{res:Tr AppTitle}"
        RequestedThemeVariant="Dark" Classes="dialog">
    <Window.Resources>
        <SolidColorBrush x:Key="ProblemBrush" Color="#FF9C9C" />
    </Window.Resources>
    <DockPanel Margin="28">
        <TextBlock DockPanel.Dock="Top" FontSize="24" FontWeight="Bold"
                   Text="{res:Tr RecoveryTitle}" Margin="0,0,0,12" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,16" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Classes="ghost" Content="{res:Tr OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" />
            <Button Content="{res:Tr RestoreBackup}" Command="{Binding RestoreCommand}"
                    IsVisible="{Binding CanRestoreBackups}" Classes="primary" />
            <Button Classes="ghost" x:Name="QuitButton" Content="{res:Tr Quit}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Problem}" Foreground="{StaticResource ProblemBrush}" TextWrapping="Wrap" />
        <DockPanel IsVisible="{Binding CanRestoreBackups}">
            <TextBlock DockPanel.Dock="Top" Text="{res:Tr Backups}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock DockPanel.Dock="Top" Text="{res:Tr NoBackups}" IsVisible="{Binding HasNoBackups}" />
            <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BackupItemViewModel">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
