<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yeetle.App.ViewModels"
             xmlns:res="using:Yeetle.App.Resources"
             xmlns:library="using:Yeetle.Domain.Library"
             xmlns:views="using:Yeetle.App.Views"
             x:Class="Yeetle.App.Views.ExplorerView"
             x:DataType="vm:ExplorerViewModel">
    <!-- Layout decided in #9 (spec §8), look from ZiL's canvas (#69): filters on the left; search,
         selection toolbar, the clip table and a footer on the right, each side a glass card. -->
    <UserControl.Resources>
        <x:Double x:Key="DimmedOpacity">0.55</x:Double>
        <!-- Column widths, shared by the header and the rows. -->
        <GridLength x:Key="DateColumn">150</GridLength>
        <GridLength x:Key="DurationColumn">80</GridLength>
        <!-- Tag filter tree rows (#83): tighter than the theme's, so more tags fit. -->
        <x:Double x:Key="TreeViewItemMinHeight">26</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource YtTextMutedBrush}" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <!-- Column headers: small and grey; a click sorts. -->
        <Style Selector="Button.header">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource YtTextMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.header:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource YtTextBrush}" />
        </Style>
        <Style Selector="Button.header:pointerover /template/ Border#RootBorder">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <!-- A tag's clip count: smaller and greyer than its name (#83). -->
        <Style Selector="TextBlock.count">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource YtTextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A clip row: rounded, the selected ones in the soft theme colour with a theme edge. -->
        <Style Selector="Border.clipRow">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="{StaticResource YtControlRadius}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBox.clips ListBoxItem">
            <Setter Property="Padding" Value="0,1" />
        </Style>
        <Style Selector="ListBox.clips ListBoxItem:pointerover Border.clipRow">
            <Setter Property="Background" Value="{StaticResource YtControlBrush}" />
        </Style>
        <Style Selector="ListBox.clips ListBoxItem:selected Border.clipRow">
            <Setter Property="Background" Value="{DynamicResource YtRowSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource YtRowSelectedBorderBrush}" />
        </Style>
        <!-- A past session (#72): a tile, the picked one in the soft theme colour. -->
        <Style Selector="ListBox.sessions ListBoxItem">
            <Setter Property="Padding" Value="0,3" />
        </Style>
        <Style Selector="ListBox.sessions ListBoxItem:pointerover Border.tile">
            <Setter Property="Background" Value="{StaticResource YtControlBrush}" />
        </Style>
        <Style Selector="ListBox.sessions ListBoxItem:selected Border.tile">
            <Setter Property="Background" Value="{DynamicResource YtRowSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource YtRowSelectedBorderBrush}" />
        </Style>
        <Style Selector="TextBlock.changed">
            <Setter Property="Foreground" Value="{StaticResource YtWarningTextBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.clipRow Border.pill">
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="300,*" ColumnSpacing="20" Margin="24,20,24,24">
        <!-- Filters (spec §8). -->
        <Border Classes="glass" Padding="14">
            <DockPanel>
                <!-- Clips | Sessions (#72): the library as it is now, or what each past session decided. -->
                <Border DockPanel.Dock="Top" Classes="segmented sunken" Margin="0,0,0,14" ToolTip.Tip="{res:Tr ExplorerModeTip}">
                    <UniformGrid Rows="1" ColumnSpacing="4">
                        <Button Classes="segment" Classes.chosen="{Binding IsClipsMode}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Command="{Binding ShowClipsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" FontSize="14" Text="{StaticResource IconVideo}" />
                                <TextBlock VerticalAlignment="Center" Text="{res:Tr ExplorerModeClips}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="segment" Classes.chosen="{Binding IsSessionsMode}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Command="{Binding ShowSessionsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" FontSize="14" Text="{StaticResource IconHistory}" />
                                <TextBlock VerticalAlignment="Center" Text="{res:Tr ExplorerModeSessions}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>
                <Button DockPanel.Dock="Bottom" Classes="link" HorizontalAlignment="Left" Margin="0,12,0,0" Content="{res:Tr ClearFilters}"
                        Command="{Binding ClearFiltersCommand}" />
                <!-- The committed sessions, most recent first (#72). -->
                <DockPanel DockPanel.Dock="Top" MaxHeight="320" Margin="0,0,0,8" IsVisible="{Binding IsSessionsMode}">
                    <TextBlock DockPanel.Dock="Top" Classes="hint" Text="{res:Tr NoPastSessions}" IsVisible="{Binding ShowNoPastSessions}" />
                    <ListBox Classes="Void sessions" ItemsSource="{Binding PastSessions}" SelectedItem="{Binding SelectedSession}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PastSessionViewModel">
                                <Border Classes="tile">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="count" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Detail}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Classes="h2" Text="{res:Tr FiltersTitle}" IsVisible="{Binding IsClipsMode}" />
                        <TextBlock Classes="h2" Text="{res:Tr FilterInSession}"
                                   IsVisible="{Binding IsSessionsMode}" />
                        <TextBlock Classes="section" Text="{res:Tr FilterTags}" />
                        <!-- Placeholders until the first load (#78). -->
                        <StackPanel Spacing="10" Margin="0,6,0,0" IsVisible="{Binding !IsLoaded}">
                            <Border Classes="skeleton" Width="90" />
                            <Border Classes="skeleton" Width="150" />
                            <Border Classes="skeleton" Width="120" />
                            <Border Classes="skeleton" Width="140" />
                            <Border Classes="skeleton" Width="100" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{res:Tr NoTagsToFilter}">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsLoaded" />
                                    <Binding Path="!HasTagFilters" />
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>
                        <!-- A tree, as folders in Windows Explorer (#83): what is under a tag is folded into
                             it, with the number of clips carrying each tag after its name. -->
                        <TreeView Classes="filters" ItemsSource="{Binding TagFilters}" Margin="-8,0,0,0">
                            <TreeView.Styles>
                                <Style Selector="TreeView.filters TreeViewItem" x:DataType="vm:TagFilterItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                                <!-- Ticking is what filters; a selected row would only look like it does too. -->
                                <Style Selector="TreeView.filters TreeViewItem:selected /template/ Border#SelectionBorder">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="TreeView.filters TreeViewItem:selected /template/ Border#SelectionBorder > ContentPresenter#PART_HeaderPresenter">
                                    <Setter Property="Foreground" Value="{StaticResource YtTextBrush}" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate DataType="vm:TagFilterItem" ItemsSource="{Binding Children}">
                                    <Panel>
                                        <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Center" IsVisible="{Binding IsHeader}" />
                                        <CheckBox IsChecked="{Binding IsChecked}" IsVisible="{Binding IsTag}" MinHeight="0">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <TextBlock Classes="count" Text="{Binding CountText}" IsVisible="{Binding HasCount}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Panel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock Classes="section" Text="{res:Tr FilterDecision}" />
                        <StackPanel IsVisible="{Binding IsClipsMode}">
                            <CheckBox Content="{res:Tr KeptLabel}" IsChecked="{Binding ShowKept}" />
                            <CheckBox Content="{res:Tr DecisionNew}" IsChecked="{Binding ShowNew}" />
                            <CheckBox Content="{res:Tr DecisionYeeted}" IsChecked="{Binding ShowYeeted}" />
                        </StackPanel>
                        <!-- In a session: the decision taken then (#72). -->
                        <StackPanel IsVisible="{Binding IsSessionsMode}">
                            <CheckBox Content="{res:Tr BadgeKept}" IsChecked="{Binding ShowSessionKept}" />
                            <CheckBox Content="{res:Tr DecisionYeeted}" IsChecked="{Binding ShowSessionYeeted}" />
                            <CheckBox Content="{res:Tr BadgeSkipped}" IsChecked="{Binding ShowSessionSkipped}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsClipsMode}">
                            <TextBlock Classes="section" Text="{res:Tr FilterFileState}" />
                            <CheckBox Content="{res:Tr StatePresent}" IsChecked="{Binding ShowPresent}" />
                            <CheckBox Content="{res:Tr StateMissing}" IsChecked="{Binding ShowMissing}" />
                            <CheckBox Content="{res:Tr StateOffline}" IsChecked="{Binding ShowOffline}" />
                            <CheckBox Content="{res:Tr StateDeleted}" IsChecked="{Binding ShowDeleted}" />
                            <CheckBox Content="{res:Tr StateNeedsAttention}" IsChecked="{Binding ShowNeedsAttention}" />
                            <TextBlock Classes="section" Text="{res:Tr FilterOther}" />
                            <CheckBox IsChecked="{Binding IncompleteOnly}">
                                <TextBlock Text="{res:Tr FilterIncomplete}" TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <!-- Search: names and marker labels. -->
            <Border DockPanel.Dock="Top" Classes="segmented" Padding="14,0" Height="42" Margin="0,0,0,14"
                    HorizontalAlignment="Left" MinWidth="420" MaxWidth="560" CornerRadius="13">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Classes="icon" FontSize="14" Margin="0,0,10,0"
                               Foreground="{StaticResource YtTextSecondaryBrush}" Text="{StaticResource IconSearch}" />
                    <TextBox Classes="bare" Text="{Binding SearchText}" PlaceholderText="{res:Tr SearchPlaceholder}"
                             VerticalAlignment="Center" AutomationProperties.Name="{res:Tr SearchPlaceholder}" />
                </DockPanel>
            </Border>

            <Border Classes="glass" Padding="0" ClipToBounds="True">
                <DockPanel>
                    <!-- Selection toolbar; tinted while something is selected. -->
                    <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource YtLineBrush}" BorderThickness="0,0,0,1"
                            Background="Transparent" Classes.selecting="{Binding HasSelection}">
                        <Border.Styles>
                            <Style Selector="Border.selecting">
                                <Setter Property="Background" Value="{DynamicResource YtRowSelectedBrush}" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" FontWeight="Bold" Margin="6,0,6,0"
                                       IsVisible="{Binding HasSelection}" />
                            <Button Classes="primary small" Content="{res:Tr OpenInYeetle}" Command="{Binding OpenCommand}" />
                            <Button Classes="ghost small" Content="{res:Tr ShowInFolder}" Command="{Binding ShowInFolderCommand}" />
                            <Button Classes="ghost small" Content="{res:Tr SetKept}" Command="{Binding SetKeptCommand}" />
                            <Button Classes="ghost small" Content="{res:Tr SetYeeted}" Command="{Binding SetYeetedCommand}" />
                            <Button Classes="ghost small" Content="{res:Tr ShowMarkers}" Command="{Binding ShowMarkersCommand}"
                                    ToolTip.Tip="{res:Tr ShowMarkersTip}" />
                            <Button Classes="ghost small" Content="{res:Tr RenameByTags}" Command="{Binding RenameByTagsCommand}" />
                            <Button Classes="ghost small" Content="{res:Tr RestoreNames}" Command="{Binding RestoreNamesCommand}" />
                            <Button Classes="ghost small" Content="{res:Tr WipeData}" Command="{Binding WipeCommand}" />
                            <Button Classes="danger small" Content="{res:Tr DeleteFromDisk}" Command="{Binding DeleteCommand}" />
                        </WrapPanel>
                    </Border>

                    <!-- Footer: match count, drag hint, and what the last action did. -->
                    <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{StaticResource YtLineBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{StaticResource YtWarningTextBrush}"
                                       IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <TextBlock FontSize="13" Classes="secondary" Text="{Binding MatchText}" />
                                <TextBlock Grid.Column="1" FontSize="13" Classes="secondary" HorizontalAlignment="Right"
                                           Text="{res:Tr DragHint}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Column headers: a click sorts, a second click turns the order around. -->
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource YtLineBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="{StaticResource DateColumn}" />
                                <ColumnDefinition Width="{StaticResource DurationColumn}" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Button Classes="header" Content="{Binding NameHeader}" Command="{Binding SortByCommand}"
                                    CommandParameter="{x:Static library:LibrarySort.Name}" />
                            <Button Grid.Column="1" Classes="header" Content="{Binding DateHeader}" Command="{Binding SortByCommand}"
                                    CommandParameter="{x:Static library:LibrarySort.RecordedAt}" />
                            <Button Grid.Column="2" Classes="header" Content="{Binding DurationHeader}" Command="{Binding SortByCommand}"
                                    CommandParameter="{x:Static library:LibrarySort.Duration}" />
                            <TextBlock Grid.Column="3" Classes="label" VerticalAlignment="Center" Text="{res:Tr ColumnTags}" />
                        </Grid>
                    </Border>

                    <Panel Margin="6">
                        <TextBlock Margin="14,16" Classes="hint" FontSize="15" Text="{res:Tr PickASession}"
                                   IsVisible="{Binding ShowPickASession}" />
                        <TextBlock Margin="14,40" Classes="hint" FontSize="15" HorizontalAlignment="Center" Text="{res:Tr NoClipsMatch}"
                                   IsVisible="{Binding ShowEmpty}" />
                        <!-- Placeholder rows until the first load (#78), in the columns of the real ones. -->
                        <ItemsControl IsVisible="{Binding !IsLoaded}" Margin="14,6" ItemsSource="{x:Static views:Placeholders.ExplorerRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="Thickness">
                                    <Grid ColumnSpacing="12" Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="{StaticResource DateColumn}" />
                                            <ColumnDefinition Width="{StaticResource DurationColumn}" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Classes="skeleton" HorizontalAlignment="Stretch" Margin="{Binding}" />
                                        <Border Grid.Column="1" Classes="skeleton" Width="110" />
                                        <Border Grid.Column="2" Classes="skeleton" Width="44" />
                                        <Border Grid.Column="3" Classes="skeleton" Width="120" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ProgressBar Classes="busy" Classes.on="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalAlignment="Top" />
                        <!-- Multiple: click, Ctrl+click, Shift+click and Ctrl+A select as in Windows Explorer.
                             The list is virtualized; its rows are plain (ListBox.Void), drawn below. -->
                        <ListBox x:Name="List" Classes="Void clips" ItemsSource="{Binding Rows}" SelectionMode="Multiple">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExplorerRowViewModel">
                                    <Border Classes="clipRow">
                                        <Grid ColumnSpacing="12" Classes.dimmed="{Binding IsDimmed}">
                                            <Grid.Styles>
                                                <Style Selector="Grid.dimmed">
                                                    <Setter Property="Opacity" Value="{StaticResource DimmedOpacity}" />
                                                </Style>
                                            </Grid.Styles>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="{StaticResource DateColumn}" />
                                                <ColumnDefinition Width="{StaticResource DurationColumn}" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Classes="pill warning" IsVisible="{Binding HasStateBadge}">
                                                    <TextBlock Text="{Binding StateBadge}" />
                                                </Border>
                                                <!-- A past session's clip decided otherwise since: "now Kept" (#72). -->
                                                <TextBlock DockPanel.Dock="Right" Classes="count" Margin="6,0,0,0" Text="{Binding DecisionNow}"
                                                           IsVisible="{Binding HasDecisionNow}" ToolTip.Tip="{res:Tr DecisionNowTip}" />
                                                <Border DockPanel.Dock="Right" Classes="pill neutral" Classes.yeeted="{Binding IsYeeted}"
                                                        Classes.kept="{Binding IsKept}" IsVisible="{Binding HasDecisionBadge}">
                                                    <TextBlock Text="{Binding DecisionBadge}" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Clip.FullPath}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Date}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding Duration}" VerticalAlignment="Center" />
                                            <DockPanel Grid.Column="3">
                                                <!-- The tags shown are the current ones; this sign says they changed since the session (#72). -->
                                                <TextBlock DockPanel.Dock="Left" Classes="changed" Text="≠" IsVisible="{Binding TagsChanged}"
                                                           ToolTip.Tip="{res:Tr TagsChangedTip}" />
                                                <TextBlock Text="{Binding Tags}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Tags}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource YtTagPillTextBrush}" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
