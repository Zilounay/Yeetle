<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yeetle.App.ViewModels"
             xmlns:res="using:Yeetle.App.Resources"
             xmlns:library="using:Yeetle.Domain.Library"
             xmlns:views="using:Yeetle.App.Views"
             x:Class="Yeetle.App.Views.ExplorerView"
             x:DataType="vm:ExplorerViewModel">
    <!-- Layout decided in #9 (spec §8): filters on the left; selection toolbar, the clip table and
         a footer on the right. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#15181D" />
        <SolidColorBrush x:Key="LineBrush" Color="#23272E" />
        <SolidColorBrush x:Key="BadgeBrush" Color="#37474F" />
        <SolidColorBrush x:Key="YeetedBadgeBrush" Color="#C62828" />
        <SolidColorBrush x:Key="KeptBadgeBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FD6" />
        <SolidColorBrush x:Key="NoticeBrush" Color="#F0B429" />
        <x:Double x:Key="SecondaryTextOpacity">0.7</x:Double>
        <x:Double x:Key="DimmedOpacity">0.5</x:Double>
        <!-- Column widths, shared by the header and the rows. -->
        <GridLength x:Key="DateColumn">150</GridLength>
        <GridLength x:Key="DurationColumn">80</GridLength>
        <!-- Tag filter tree rows (#83): tighter than the theme's 32 px, so more tags fit. -->
        <x:Double x:Key="TreeViewItemMinHeight">26</x:Double>
        <x:Double x:Key="CountOpacity">0.5</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="{StaticResource SecondaryTextOpacity}" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style Selector="Button.header">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <!-- A tag's clip count: smaller and greyer than its name (#83). -->
        <Style Selector="TextBlock.count">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="{StaticResource CountOpacity}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{StaticResource BadgeBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge.kept">
            <Setter Property="Background" Value="{StaticResource KeptBadgeBrush}" />
        </Style>
        <!-- The Clips | Sessions switch (#72): two halves, the current one in the accent blue. -->
        <Style Selector="Border.modes">
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="Button.mode">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.mode.current /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.changed">
            <Setter Property="Foreground" Value="{StaticResource NoticeBrush}" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge.yeeted">
            <Setter Property="Background" Value="{StaticResource YeetedBadgeBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="260,*">
        <!-- Filters (spec §8). -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0"
                Padding="16,12">
            <DockPanel>
                <!-- Clips | Sessions (#72): the library as it is now, or what each past session decided. -->
                <Border DockPanel.Dock="Top" Classes="modes" Margin="0,0,0,12" ToolTip.Tip="{res:Tr ExplorerModeTip}">
                    <UniformGrid Rows="1">
                        <Button Classes="mode" Classes.current="{Binding IsClipsMode}" Content="{res:Tr ExplorerModeClips}"
                                Command="{Binding ShowClipsCommand}" />
                        <Button Classes="mode" Classes.current="{Binding IsSessionsMode}"
                                Content="{res:Tr ExplorerModeSessions}" Command="{Binding ShowSessionsCommand}" />
                    </UniformGrid>
                </Border>
                <Button DockPanel.Dock="Bottom" Margin="0,12,0,0" Content="{res:Tr ClearFilters}"
                        Command="{Binding ClearFiltersCommand}" />
                <!-- The committed sessions, most recent first (#72). -->
                <DockPanel DockPanel.Dock="Top" MaxHeight="320" Margin="0,0,0,8" IsVisible="{Binding IsSessionsMode}">
                    <TextBlock DockPanel.Dock="Top" Text="{res:Tr NoPastSessions}" TextWrapping="Wrap"
                               Opacity="{StaticResource SecondaryTextOpacity}" IsVisible="{Binding ShowNoPastSessions}" />
                    <ListBox ItemsSource="{Binding PastSessions}" SelectedItem="{Binding SelectedSession}" Background="Transparent"
                             Classes="sessions">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PastSessionViewModel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="count" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Detail}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="Bold" Text="{res:Tr FiltersTitle}" IsVisible="{Binding IsClipsMode}" />
                        <TextBlock FontSize="16" FontWeight="Bold" Text="{res:Tr FilterInSession}"
                                   IsVisible="{Binding IsSessionsMode}" />
                        <TextBlock Classes="section" Text="{res:Tr FilterTags}" />
                        <!-- Placeholders until the first load (#78). -->
                        <StackPanel Spacing="10" Margin="0,6,0,0" IsVisible="{Binding !IsLoaded}">
                            <Border Classes="skeleton" Width="90" />
                            <Border Classes="skeleton" Width="150" />
                            <Border Classes="skeleton" Width="120" />
                            <Border Classes="skeleton" Width="140" />
                            <Border Classes="skeleton" Width="100" />
                        </StackPanel>
                        <TextBlock Text="{res:Tr NoTagsToFilter}" Opacity="{StaticResource SecondaryTextOpacity}">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsLoaded" />
                                    <Binding Path="!HasTagFilters" />
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>
                        <!-- A tree, as folders in Windows Explorer (#83): what is under a tag is folded into
                             it, with the number of clips carrying each tag after its name. -->
                        <TreeView Classes="filters" ItemsSource="{Binding TagFilters}" Margin="-8,0,0,0">
                            <TreeView.Styles>
                                <Style Selector="TreeView.filters TreeViewItem" x:DataType="vm:TagFilterItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                                <!-- Ticking is what filters; a selected row would only look like it does too. -->
                                <Style Selector="TreeView.filters TreeViewItem:selected /template/ Border#PART_LayoutRoot">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate DataType="vm:TagFilterItem" ItemsSource="{Binding Children}">
                                    <Panel>
                                        <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                                                   Opacity="{StaticResource SecondaryTextOpacity}" IsVisible="{Binding IsHeader}" />
                                        <CheckBox IsChecked="{Binding IsChecked}" IsVisible="{Binding IsTag}" MinHeight="0">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <TextBlock Classes="count" Text="{Binding CountText}" IsVisible="{Binding HasCount}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Panel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock Classes="section" Text="{res:Tr FilterDecision}" />
                        <StackPanel IsVisible="{Binding IsClipsMode}">
                            <CheckBox Content="{res:Tr KeptLabel}" IsChecked="{Binding ShowKept}" />
                            <CheckBox Content="{res:Tr DecisionNew}" IsChecked="{Binding ShowNew}" />
                            <CheckBox Content="{res:Tr DecisionYeeted}" IsChecked="{Binding ShowYeeted}" />
                        </StackPanel>
                        <!-- In a session: the decision taken then (#72). -->
                        <StackPanel IsVisible="{Binding IsSessionsMode}">
                            <CheckBox Content="{res:Tr BadgeKept}" IsChecked="{Binding ShowSessionKept}" />
                            <CheckBox Content="{res:Tr DecisionYeeted}" IsChecked="{Binding ShowSessionYeeted}" />
                            <CheckBox Content="{res:Tr BadgeSkipped}" IsChecked="{Binding ShowSessionSkipped}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsClipsMode}">
                            <TextBlock Classes="section" Text="{res:Tr FilterFileState}" />
                            <CheckBox Content="{res:Tr StatePresent}" IsChecked="{Binding ShowPresent}" />
                            <CheckBox Content="{res:Tr StateMissing}" IsChecked="{Binding ShowMissing}" />
                            <CheckBox Content="{res:Tr StateOffline}" IsChecked="{Binding ShowOffline}" />
                            <CheckBox Content="{res:Tr StateDeleted}" IsChecked="{Binding ShowDeleted}" />
                            <CheckBox Content="{res:Tr StateNeedsAttention}" IsChecked="{Binding ShowNeedsAttention}" />
                            <TextBlock Classes="section" Text="{res:Tr FilterOther}" />
                            <CheckBox IsChecked="{Binding IncompleteOnly}">
                                <TextBlock Text="{res:Tr FilterIncomplete}" TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="16,12,16,12">
            <TextBox DockPanel.Dock="Top" Text="{Binding SearchText}" PlaceholderText="{res:Tr SearchPlaceholder}"
                     Margin="0,0,0,10" />

            <!-- Selection toolbar. -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" ItemSpacing="6" LineSpacing="6">
                <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"
                           IsVisible="{Binding HasSelection}" />
                <Button Content="{res:Tr ShowInFolder}" Command="{Binding ShowInFolderCommand}" />
                <Button Content="{res:Tr SetKept}" Command="{Binding SetKeptCommand}" />
                <Button Content="{res:Tr SetYeeted}" Command="{Binding SetYeetedCommand}" />
                <Button Content="{res:Tr ShowMarkers}" Command="{Binding ShowMarkersCommand}"
                        ToolTip.Tip="{res:Tr ShowMarkersTip}" />
                <Button Content="{res:Tr RenameByTags}" Command="{Binding RenameByTagsCommand}" />
                <Button Content="{res:Tr RestoreNames}" Command="{Binding RestoreNamesCommand}" />
                <Button Content="{res:Tr WipeData}" Command="{Binding WipeCommand}" />
                <Button Content="{res:Tr DeleteFromDisk}" Command="{Binding DeleteCommand}" />
            </WrapPanel>

            <!-- Footer: match count, drag hint, and what the last action did. -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="2">
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{StaticResource NoticeBrush}"
                           IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <TextBlock Text="{Binding MatchText}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{res:Tr DragHint}" TextTrimming="CharacterEllipsis"
                               Opacity="{StaticResource SecondaryTextOpacity}" />
                </Grid>
            </StackPanel>

            <!-- Column headers: a click sorts, a second click turns the order around. -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="{StaticResource DateColumn}" />
                        <ColumnDefinition Width="{StaticResource DurationColumn}" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Button Classes="header" Content="{Binding NameHeader}" Command="{Binding SortByCommand}"
                            CommandParameter="{x:Static library:LibrarySort.Name}" />
                    <Button Grid.Column="1" Classes="header" Content="{Binding DateHeader}" Command="{Binding SortByCommand}"
                            CommandParameter="{x:Static library:LibrarySort.RecordedAt}" />
                    <Button Grid.Column="2" Classes="header" Content="{Binding DurationHeader}" Command="{Binding SortByCommand}"
                            CommandParameter="{x:Static library:LibrarySort.Duration}" />
                    <TextBlock Grid.Column="3" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="{res:Tr ColumnTags}" />
                </Grid>
            </Border>

            <Panel>
                <TextBlock Margin="8,16" Text="{res:Tr PickASession}" Opacity="{StaticResource SecondaryTextOpacity}"
                           IsVisible="{Binding ShowPickASession}" />
                <TextBlock Margin="8,16" Text="{res:Tr NoClipsMatch}" Opacity="{StaticResource SecondaryTextOpacity}"
                           IsVisible="{Binding ShowEmpty}" />
                <!-- Placeholder rows until the first load (#78), in the columns of the real ones. -->
                <ItemsControl IsVisible="{Binding !IsLoaded}" Margin="8,6" ItemsSource="{x:Static views:Placeholders.ExplorerRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="Thickness">
                            <Grid ColumnSpacing="12" Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="{StaticResource DateColumn}" />
                                    <ColumnDefinition Width="{StaticResource DurationColumn}" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Classes="skeleton" HorizontalAlignment="Stretch" Margin="{Binding}" />
                                <Border Grid.Column="1" Classes="skeleton" Width="110" />
                                <Border Grid.Column="2" Classes="skeleton" Width="44" />
                                <Border Grid.Column="3" Classes="skeleton" Width="120" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressBar Classes="busy" Classes.on="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalAlignment="Top" />
                <!-- Multiple: click, Ctrl+click, Shift+click and Ctrl+A select as in Windows Explorer.
                     The list is virtualized. -->
                <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectionMode="Multiple" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExplorerRowViewModel">
                            <Grid ColumnSpacing="12" Classes.dimmed="{Binding IsDimmed}">
                                <Grid.Styles>
                                    <Style Selector="Grid.dimmed">
                                        <Setter Property="Opacity" Value="{StaticResource DimmedOpacity}" />
                                    </Style>
                                </Grid.Styles>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="{StaticResource DateColumn}" />
                                    <ColumnDefinition Width="{StaticResource DurationColumn}" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Classes="badge" IsVisible="{Binding HasStateBadge}">
                                        <TextBlock FontSize="11" Text="{Binding StateBadge}" />
                                    </Border>
                                    <!-- A past session's clip decided otherwise since: "now Kept" (#72). -->
                                    <TextBlock DockPanel.Dock="Right" Classes="count" Margin="6,0,0,0" Text="{Binding DecisionNow}"
                                               IsVisible="{Binding HasDecisionNow}" ToolTip.Tip="{res:Tr DecisionNowTip}" />
                                    <Border DockPanel.Dock="Right" Classes="badge" Classes.yeeted="{Binding IsYeeted}"
                                            Classes.kept="{Binding IsKept}" IsVisible="{Binding HasDecisionBadge}">
                                        <TextBlock FontSize="11" Text="{Binding DecisionBadge}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Clip.FullPath}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Date}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Duration}" FontFamily="Consolas,monospace"
                                           VerticalAlignment="Center" />
                                <DockPanel Grid.Column="3">
                                    <!-- The tags shown are the current ones; this sign says they changed since the session (#72). -->
                                    <TextBlock DockPanel.Dock="Left" Classes="changed" Text="≠" IsVisible="{Binding TagsChanged}"
                                               ToolTip.Tip="{res:Tr TagsChangedTip}" />
                                    <TextBlock Text="{Binding Tags}" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Tags}" VerticalAlignment="Center"
                                               Opacity="{StaticResource SecondaryTextOpacity}" />
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </DockPanel>
    </Grid>
</UserControl>
