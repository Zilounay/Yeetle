<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yeetle.App.ViewModels"
        xmlns:res="using:Yeetle.App.Resources"
        x:Class="Yeetle.App.Views.DeletePromptWindow"
        x:DataType="vm:DeletePromptViewModel"
        Title="{Binding Title}"
        Width="680" SizeToContent="Height" MaxHeight="640" MinWidth="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark" Classes="dialog">
    <!-- Destructive styling with a warning icon, and keeping the files as the safe choice
         (spec §9, layout from #9). -->
    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource YtYeetSoftBrush}">
                <TextBlock Classes="icon" FontSize="20" Foreground="{StaticResource YtYeetTextBrush}" Text="{StaticResource IconWarning}" />
            </Border>
            <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" FontSize="15" Foreground="#D6D9E2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border DockPanel.Dock="Top" Background="{StaticResource YtDangerBrush}" BorderBrush="{StaticResource YtDangerBorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource YtBlockRadius}" Padding="14,12" Margin="0,0,0,12">
            <TextBlock Text="{res:Tr RecycleBinWarning}" TextWrapping="Wrap" />
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="KeepButton" Classes="ghost large" Content="{res:Tr KeepTheFiles}" IsCancel="True" IsDefault="True" />
            <Button x:Name="DeleteButton" Classes="danger solid large" Content="{Binding DeleteLabel}" />
        </StackPanel>

        <Expander Header="{Binding ListTitle}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <ScrollViewer MaxHeight="240">
                <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeleteFileViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="muted" Text="{Binding Folder}"
                                               TextTrimming="PathSegmentEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Size}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Expander>
    </DockPanel>
</Window>
