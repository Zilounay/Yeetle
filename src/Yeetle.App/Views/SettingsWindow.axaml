<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yeetle.App.ViewModels"
        xmlns:res="using:Yeetle.App.Resources"
        x:Class="Yeetle.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{res:Tr SettingsTitle}"
        Width="980" Height="700" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark">
    <!-- Spec §11, decided in #20: sections on the left as on ZiL's canvas, each change saved at once.
         Barebones until the visual pass (#69). -->
    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#0E1013" />
        <SolidColorBrush x:Key="PanelBrush" Color="#15181D" />
        <SolidColorBrush x:Key="LineBrush" Color="#23272E" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#FF9A92" />
        <x:Double x:Key="SecondaryTextOpacity">0.7</x:Double>
        <x:Double x:Key="NumberWidth">140</x:Double>
        <SolidColorBrush x:Key="KeyBrush" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FD6" />
        <SolidColorBrush x:Key="CapturingBrush" Color="#332F6FD6" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,14" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="{StaticResource SecondaryTextOpacity}" />
        </Style>
        <Style Selector="TextBlock.problem">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
        </Style>
        <Style Selector="Border.key">
            <Setter Property="Background" Value="{StaticResource KeyBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Button.plain">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- The action waiting for its key stands out. -->
        <Style Selector="Grid.capturing">
            <Setter Property="Background" Value="{StaticResource CapturingBrush}" />
        </Style>
        <Style Selector="Button.language.current /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- The theme writes On / Off in English; these follow the language (#20). -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="{res:Tr SwitchOn}" />
            <Setter Property="OffContent" Value="{res:Tr SwitchOff}" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Width" Value="{StaticResource NumberWidth}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*" Background="{StaticResource PageBrush}">
        <!-- Sections. -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0"
                Padding="12,18">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="title" Margin="8,0,0,14" Text="{res:Tr SettingsTitle}" />
                <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="8,12,0,0" Text="{Binding Version}" />
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsSectionItem">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="28,22">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Classes="title" Text="{Binding SelectedSection.Label}" />

                <!-- Library -->
                <Border Classes="card" IsVisible="{Binding IsLibrary}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{res:Tr SourceFoldersButton}" Command="{Binding OpenSourceFoldersCommand}" />
                            <Button Content="{res:Tr Rescan}" Command="{Binding RescanCommand}" />
                        </StackPanel>
                        <TextBlock Classes="label" Text="{res:Tr ExtensionsLabel}" />
                        <TextBox Text="{Binding ExtensionsText}" />
                        <TextBlock Classes="hint" Text="{res:Tr ExtensionsHint}" />
                        <TextBlock Classes="problem" Text="{Binding ExtensionsProblem}"
                                   IsVisible="{Binding ExtensionsProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>

                <!-- Tags -->
                <Border Classes="card" IsVisible="{Binding IsTags}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="hint" Text="{res:Tr TagsSectionHint}" />
                        <Button Content="{res:Tr TagManagerTitle}" Command="{Binding OpenTagManagerCommand}" />
                    </StackPanel>
                </Border>

                <!-- Hotkeys (spec §14): one key, one action; tag keys are set in the Tag Manager. -->
                <StackPanel Spacing="16" IsVisible="{Binding IsHotkeys}">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="hint" Text="{res:Tr HotkeysHint}" />
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Hotkeys.Message}"
                                       IsVisible="{Binding Hotkeys.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <ItemsControl ItemsSource="{Binding Hotkeys.Actions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HotkeyActionViewModel">
                                        <Grid ColumnDefinitions="260,*" Margin="0,3" Classes.capturing="{Binding IsCapturing}">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Label}" TextWrapping="Wrap" />
                                            <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="4">
                                                <TextBlock VerticalAlignment="Center" Classes="hint" Text="{res:Tr NoKey}"
                                                           IsVisible="{Binding HasNoKey}" />
                                                <ItemsControl ItemsSource="{Binding Keys}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:HotkeyKeyViewModel">
                                                            <Border Classes="key">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                                                    <Button Classes="plain" Content="×" Command="{Binding Remove}"
                                                                            ToolTip.Tip="{res:Tr RemoveKeyTip}"
                                                                            AutomationProperties.Name="{res:Tr RemoveKeyTip}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="{res:Tr AddKey}"
                                                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).Hotkeys.StartCaptureCommand}"
                                                        CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Margin="0,8,0,0" Content="{res:Tr RestoreDefaultKeys}"
                                    Command="{Binding Hotkeys.RestoreDefaultsCommand}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="{res:Tr TagHotkeysLabel}" />
                            <TextBlock Classes="hint" Text="{res:Tr TagHotkeysHint}" />
                            <ItemsControl ItemsSource="{Binding Hotkeys.TagHotkeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagHotkeyViewModel">
                                        <Grid ColumnDefinitions="260,*" Margin="0,2">
                                            <TextBlock Text="{Binding Tag}" />
                                            <Border Grid.Column="1" Classes="key" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Key}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{res:Tr TagManagerTitle}" Command="{Binding Hotkeys.OpenTagManagerCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Player -->
                <Border Classes="card" IsVisible="{Binding IsPlayer}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="{res:Tr DefaultSpeedLabel}" />
                        <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding DefaultSpeed}" MinWidth="140">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpeedOptionViewModel">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="label" Text="{res:Tr DefaultVolumeLabel}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider Width="260" Minimum="0" Maximum="100" Value="{Binding DefaultVolume}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding DefaultVolume, StringFormat={}{0:0}}" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{res:Tr PlayerDefaultsHint}" />
                        <TextBlock Classes="label" Text="{res:Tr SeekStepLabel}" />
                        <NumericUpDown Value="{Binding SeekSeconds}" Minimum="1" Maximum="60" Increment="1" FormatString="0" />
                        <TextBlock Classes="label" Text="{res:Tr LongSeekStepLabel}" />
                        <NumericUpDown Value="{Binding LongSeekSeconds}" Minimum="1" Maximum="600" Increment="5" FormatString="0" />
                        <TextBlock Classes="label" Text="{res:Tr VolumeStepLabel}" />
                        <NumericUpDown Value="{Binding VolumeStep}" Minimum="1" Maximum="50" Increment="1" FormatString="0" />
                        <ToggleSwitch Margin="0,8,0,0" IsChecked="{Binding StartInTheatreMode}"
                                      Content="{res:Tr TheatreAtStartLabel}" />
                        <ToggleSwitch IsChecked="{Binding PrepareNeighbours}" Content="{res:Tr PrepareNeighboursLabel}" />
                        <TextBlock Classes="hint" Text="{res:Tr PrepareNeighboursHint}" />
                    </StackPanel>
                </Border>

                <!-- Review -->
                <Border Classes="card" IsVisible="{Binding IsReview}">
                    <StackPanel Spacing="8">
                        <ToggleSwitch IsChecked="{Binding StickyTags}" Content="{res:Tr StickyTagsLabel}" />
                        <TextBlock Classes="hint" Text="{res:Tr StickyTagsHint}" />
                        <TextBlock Classes="label" Text="{res:Tr MarkerOffsetLabel}" />
                        <NumericUpDown Value="{Binding MarkerOffsetSeconds}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0" />
                        <TextBlock Classes="hint" Text="{res:Tr MarkerOffsetHint}" />
                    </StackPanel>
                </Border>

                <!-- Explorer filters -->
                <Border Classes="card" IsVisible="{Binding IsLibraryView}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="hint" Text="{res:Tr LibraryViewHint}" />
                        <TextBlock Classes="label" Text="{res:Tr FilterDecision}" />
                        <CheckBox Content="{res:Tr KeptLabel}" IsChecked="{Binding DefaultKept}" />
                        <CheckBox Content="{res:Tr DecisionNew}" IsChecked="{Binding DefaultNew}" />
                        <CheckBox Content="{res:Tr DecisionYeeted}" IsChecked="{Binding DefaultYeeted}" />
                        <TextBlock Classes="label" Text="{res:Tr FilterFileState}" />
                        <CheckBox Content="{res:Tr StatePresent}" IsChecked="{Binding DefaultPresent}" />
                        <CheckBox Content="{res:Tr StateMissing}" IsChecked="{Binding DefaultMissing}" />
                        <CheckBox Content="{res:Tr StateOffline}" IsChecked="{Binding DefaultOffline}" />
                        <CheckBox Content="{res:Tr StateDeleted}" IsChecked="{Binding DefaultDeleted}" />
                        <CheckBox Content="{res:Tr StateNeedsAttention}" IsChecked="{Binding DefaultNeedsAttention}" />
                    </StackPanel>
                </Border>

                <!-- Data -->
                <StackPanel Spacing="16" IsVisible="{Binding IsData}">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="label" Text="{res:Tr BackupCountsLabel}" />
                            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                                <TextBlock VerticalAlignment="Center" Text="{res:Tr BackupPoolSession}" />
                                <NumericUpDown Grid.Column="1" Value="{Binding SessionBackups}" Minimum="1"
                                               Maximum="{x:Static vm:SettingsViewModel.BackupCountMaximum}" FormatString="0" />
                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{res:Tr BackupPoolDaily}" />
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DailyBackups}" Minimum="1"
                                               Maximum="{x:Static vm:SettingsViewModel.BackupCountMaximum}" FormatString="0" />
                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{res:Tr BackupPoolSafety}" />
                                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SafetyBackups}" Minimum="1"
                                               Maximum="{x:Static vm:SettingsViewModel.BackupCountMaximum}" FormatString="0" />
                            </Grid>
                            <Button Margin="0,6,0,0" Content="{res:Tr OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="label" Text="{res:Tr RestoreBackupLabel}" />
                            <TextBlock Classes="hint" Text="{res:Tr RestoreBackupHint}" />
                            <ListBox ItemsSource="{Binding BackupChoices}" SelectedItem="{Binding SelectedBackup}" MaxHeight="240"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BackupChoice">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="{res:Tr RestoreButton}" Command="{Binding RestoreBackupCommand}" />
                            <TextBlock Classes="hint" Text="{res:Tr RestoreDuringSession}" IsVisible="{Binding !CanRestoreNow}" />
                            <TextBlock Classes="problem" Text="{Binding RestoreProblem}"
                                       IsVisible="{Binding RestoreProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- General -->
                <Border Classes="card" IsVisible="{Binding IsGeneral}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="{res:Tr LanguageLabel}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- Language names stay in their own language, so anyone can find theirs. -->
                            <Button Classes="language" Classes.current="{Binding IsEnglish}" Content="{res:Tr LanguageEnglish}"
                                    Command="{Binding UseLanguageCommand}" CommandParameter="{x:Static res:Loc.English}" />
                            <Button Classes="language" Classes.current="{Binding IsFrench}" Content="{res:Tr LanguageFrench}"
                                    Command="{Binding UseLanguageCommand}" CommandParameter="{x:Static res:Loc.French}" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{res:Tr LanguageHint}" />
                        <TextBlock Classes="label" Text="{res:Tr UpdatesLabel}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="{res:Tr CheckNow}" Command="{Binding CheckForUpdatesCommand}" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Text="{Binding UpdateResult}" />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding CheckAtStartup}" Content="{res:Tr CheckAtStartupLabel}" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="hint" Text="{Binding SettingsFile}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
