<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yeetle.App.ViewModels"
        xmlns:res="using:Yeetle.App.Resources"
        xmlns:controls="using:Yeetle.App.Controls"
        x:Class="Yeetle.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{res:Tr SettingsTitle}"
        Width="1100" Height="760" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark">
    <!-- Spec §11, decided in #20, look from ZiL's canvas (#69): sections on the left, each change
         saved at once. -->
    <Window.Resources>
        <x:Double x:Key="NumberWidth">140</x:Double>
        <x:Double x:Key="HotkeyLabelWidth">260</x:Double>
        <SolidColorBrush x:Key="CapturingBrush" Color="#330A59F7" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="StackPanel.card > TextBlock.label">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="Button.plain">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- The action waiting for its key stands out. -->
        <Style Selector="Grid.capturing">
            <Setter Property="Background" Value="{StaticResource CapturingBrush}" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Width" Value="{StaticResource NumberWidth}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- A setting: what it is on the left, its switch on the right, a line between settings. -->
        <Style Selector="Grid.setting">
            <Setter Property="Margin" Value="0,12" />
        </Style>
    </Window.Styles>

    <Panel>
        <controls:GlowBackground />
        <DockPanel>
            <Border DockPanel.Dock="Top" Classes="header">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="logo">
                        <TextBlock Classes="icon" Foreground="White" Text="{StaticResource IconSettings}" />
                    </Border>
                    <TextBlock FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Text="{res:Tr SettingsTitle}" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="260,*" Margin="24" ColumnSpacing="24">
                <!-- Sections. -->
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Classes="muted" Margin="14,12,0,0" Text="{Binding Version}" />
                    <ListBox Classes="Void" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                             AutomationProperties.Name="{res:Tr SettingsTitle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsSectionItem">
                                <Border Classes="navRow">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Ellipse Classes="dot" />
                                        <TextBlock Text="{Binding Label}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <ScrollViewer Grid.Column="1">
                    <StackPanel Spacing="20" MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,12,0">
                        <TextBlock Classes="h1" Text="{Binding SelectedSection.Label}" />

                        <!-- Library -->
                        <Border Classes="glass" Padding="22" IsVisible="{Binding IsLibrary}">
                            <StackPanel Classes="card" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="ghost" Content="{res:Tr SourceFoldersButton}" Command="{Binding OpenSourceFoldersCommand}" />
                                    <Button Classes="ghost" Content="{res:Tr Rescan}" Command="{Binding RescanCommand}" />
                                </StackPanel>
                                <TextBlock Classes="label" Text="{res:Tr ExtensionsLabel}" />
                                <TextBox Text="{Binding ExtensionsText}" />
                                <TextBlock Classes="hint" Text="{res:Tr ExtensionsHint}" />
                                <TextBlock Classes="problem" Text="{Binding ExtensionsProblem}"
                                           IsVisible="{Binding ExtensionsProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>

                        <!-- Tags -->
                        <Border Classes="glass" Padding="22" IsVisible="{Binding IsTags}">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="hint" Text="{res:Tr TagsSectionHint}" />
                                <Button Classes="primary" HorizontalAlignment="Left" Content="{res:Tr TagManagerTitle}"
                                        Command="{Binding OpenTagManagerCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Hotkeys (spec §14): one key, one action; tag keys are set in the Tag Manager. -->
                        <StackPanel Spacing="20" IsVisible="{Binding IsHotkeys}">
                            <Border Classes="glass" Padding="22">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="hint" Text="{res:Tr HotkeysHint}" />
                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Hotkeys.Message}"
                                               IsVisible="{Binding Hotkeys.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <ItemsControl ItemsSource="{Binding Hotkeys.Actions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HotkeyActionViewModel">
                                                <Grid ColumnDefinitions="260,*" Margin="0,3" Classes.capturing="{Binding IsCapturing}">
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" TextWrapping="Wrap" />
                                                    <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="4">
                                                        <TextBlock VerticalAlignment="Center" Classes="hint" Text="{res:Tr NoKey}"
                                                                   IsVisible="{Binding HasNoKey}" />
                                                        <ItemsControl ItemsSource="{Binding Keys}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel ItemSpacing="6" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:HotkeyKeyViewModel">
                                                                    <Border Classes="key" Padding="8,3">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="{Binding Label}" />
                                                                            <Button Classes="plain" Content="×" Command="{Binding Remove}"
                                                                                    ToolTip.Tip="{res:Tr RemoveKeyTip}"
                                                                                    AutomationProperties.Name="{res:Tr RemoveKeyTip}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Classes="ghost small" Content="{res:Tr AddKey}"
                                                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).Hotkeys.StartCaptureCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </WrapPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Classes="ghost" Margin="0,8,0,0" HorizontalAlignment="Left" Content="{res:Tr RestoreDefaultKeys}"
                                            Command="{Binding Hotkeys.RestoreDefaultsCommand}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="glass" Padding="22">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="h2" Text="{res:Tr TagHotkeysLabel}" />
                                    <TextBlock Classes="hint" Text="{res:Tr TagHotkeysHint}" />
                                    <ItemsControl ItemsSource="{Binding Hotkeys.TagHotkeys}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TagHotkeyViewModel">
                                                <Grid ColumnDefinitions="260,*" Margin="0,3">
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Tag}" />
                                                    <Border Grid.Column="1" Classes="key" HorizontalAlignment="Left" Padding="8,3">
                                                        <TextBlock FontSize="13" Text="{Binding Key}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Classes="ghost" Margin="0,6,0,0" HorizontalAlignment="Left" Content="{res:Tr TagManagerTitle}"
                                            Command="{Binding Hotkeys.OpenTagManagerCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Player -->
                        <Border Classes="glass" Padding="22" IsVisible="{Binding IsPlayer}">
                            <StackPanel Classes="card" Spacing="8">
                                <TextBlock Classes="label" Text="{res:Tr DefaultSpeedLabel}" />
                                <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding DefaultSpeed}" MinWidth="140">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SpeedOptionViewModel">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="label" Text="{res:Tr DefaultVolumeLabel}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Slider Width="260" Minimum="0" Maximum="100" Value="{Binding DefaultVolume}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding DefaultVolume, StringFormat={}{0:0}}" />
                                </StackPanel>
                                <TextBlock Classes="hint" Text="{res:Tr PlayerDefaultsHint}" />
                                <TextBlock Classes="label" Text="{res:Tr SeekStepLabel}" />
                                <NumericUpDown Value="{Binding SeekSeconds}" Minimum="1" Maximum="60" Increment="1" FormatString="0" />
                                <TextBlock Classes="label" Text="{res:Tr LongSeekStepLabel}" />
                                <NumericUpDown Value="{Binding LongSeekSeconds}" Minimum="1" Maximum="600" Increment="5" FormatString="0" />
                                <TextBlock Classes="label" Text="{res:Tr VolumeStepLabel}" />
                                <NumericUpDown Value="{Binding VolumeStep}" Minimum="1" Maximum="50" Increment="1" FormatString="0" />
                                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="h3" VerticalAlignment="Center" TextWrapping="Wrap" Text="{res:Tr TheatreAtStartLabel}" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartInTheatreMode}"
                                                  AutomationProperties.Name="{res:Tr TheatreAtStartLabel}" />
                                </Grid>
                                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="h3" TextWrapping="Wrap" Text="{res:Tr PrepareNeighboursLabel}" />
                                        <TextBlock Classes="hint" Text="{res:Tr PrepareNeighboursHint}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding PrepareNeighbours}"
                                                  AutomationProperties.Name="{res:Tr PrepareNeighboursLabel}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Review -->
                        <Border Classes="glass" Padding="22" IsVisible="{Binding IsReview}">
                            <StackPanel Classes="card" Spacing="8">
                                <Grid Classes="setting" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="h3" TextWrapping="Wrap" Text="{res:Tr StickyTagsLabel}" />
                                        <TextBlock Classes="hint" Text="{res:Tr StickyTagsHint}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding StickyTags}"
                                                  AutomationProperties.Name="{res:Tr StickyTagsLabel}" />
                                </Grid>
                                <TextBlock Classes="label" Text="{res:Tr MarkerOffsetLabel}" />
                                <NumericUpDown Value="{Binding MarkerOffsetSeconds}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0" />
                                <TextBlock Classes="hint" Text="{res:Tr MarkerOffsetHint}" />
                            </StackPanel>
                        </Border>

                        <!-- Explorer filters -->
                        <Border Classes="glass" Padding="22" IsVisible="{Binding IsLibraryView}">
                            <StackPanel Classes="card" Spacing="6">
                                <TextBlock Classes="hint" Text="{res:Tr LibraryViewHint}" />
                                <TextBlock Classes="label" Text="{res:Tr FilterDecision}" />
                                <CheckBox Content="{res:Tr KeptLabel}" IsChecked="{Binding DefaultKept}" />
                                <CheckBox Content="{res:Tr DecisionNew}" IsChecked="{Binding DefaultNew}" />
                                <CheckBox Content="{res:Tr DecisionYeeted}" IsChecked="{Binding DefaultYeeted}" />
                                <TextBlock Classes="label" Text="{res:Tr FilterFileState}" />
                                <CheckBox Content="{res:Tr StatePresent}" IsChecked="{Binding DefaultPresent}" />
                                <CheckBox Content="{res:Tr StateMissing}" IsChecked="{Binding DefaultMissing}" />
                                <CheckBox Content="{res:Tr StateOffline}" IsChecked="{Binding DefaultOffline}" />
                                <CheckBox Content="{res:Tr StateDeleted}" IsChecked="{Binding DefaultDeleted}" />
                                <CheckBox Content="{res:Tr StateNeedsAttention}" IsChecked="{Binding DefaultNeedsAttention}" />
                            </StackPanel>
                        </Border>

                        <!-- Data -->
                        <StackPanel Spacing="20" IsVisible="{Binding IsData}">
                            <Border Classes="glass" Padding="22">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="{res:Tr BackupCountsLabel}" />
                                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="{res:Tr BackupPoolSession}" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding SessionBackups}" Minimum="1"
                                                       Maximum="{x:Static vm:SettingsViewModel.BackupCountMaximum}" FormatString="0" />
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{res:Tr BackupPoolDaily}" />
                                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DailyBackups}" Minimum="1"
                                                       Maximum="{x:Static vm:SettingsViewModel.BackupCountMaximum}" FormatString="0" />
                                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{res:Tr BackupPoolSafety}" />
                                        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SafetyBackups}" Minimum="1"
                                                       Maximum="{x:Static vm:SettingsViewModel.BackupCountMaximum}" FormatString="0" />
                                    </Grid>
                                    <Button Classes="ghost" Margin="0,6,0,0" HorizontalAlignment="Left" Content="{res:Tr OpenDataFolder}"
                                            Command="{Binding OpenDataFolderCommand}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="glass" Padding="22">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="{res:Tr RestoreBackupLabel}" />
                                    <TextBlock Classes="hint" Text="{res:Tr RestoreBackupHint}" />
                                    <ListBox ItemsSource="{Binding BackupChoices}" SelectedItem="{Binding SelectedBackup}" MaxHeight="260">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BackupChoice">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Classes="danger" HorizontalAlignment="Left" Content="{res:Tr RestoreButton}"
                                            Command="{Binding RestoreBackupCommand}" />
                                    <TextBlock Classes="hint" Text="{res:Tr RestoreDuringSession}" IsVisible="{Binding !CanRestoreNow}" />
                                    <TextBlock Classes="problem" Text="{Binding RestoreProblem}"
                                               IsVisible="{Binding RestoreProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Appearance (#69): colour theme, then the motion switches. -->
                        <StackPanel Spacing="20" IsVisible="{Binding IsAppearance}">
                            <TextBlock Classes="hint" FontSize="15" Margin="0,-12,0,0" Text="{res:Tr AppearanceIntro}" />
                            <Border Classes="glass" Padding="22">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="h2" Text="{res:Tr ColourThemeLabel}" />
                                        <TextBlock Classes="hint" Text="{res:Tr ColourThemeHint}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding ColourThemes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" ColumnSpacing="12" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ColourThemeOption">
                                                <Button Classes="card" Classes.current="{Binding IsCurrent}"
                                                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).UseColourThemeCommand}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                                    <StackPanel Spacing="10">
                                                        <!-- The theme in small: its page and lights, a button, the seek bar and a marker. -->
                                                        <Border Height="86" CornerRadius="12" ClipToBounds="True" Background="{Binding PageBrush}"
                                                                BorderBrush="{StaticResource YtLineBrush}" BorderThickness="1">
                                                            <Panel>
                                                                <Border Background="{Binding FirstGlowBrush}" />
                                                                <Border Background="{Binding SecondGlowBrush}" />
                                                                <Canvas>
                                                                    <Border Canvas.Left="12" Canvas.Top="14" Width="74" Height="22" CornerRadius="8"
                                                                            Background="{Binding PrimaryBrush}" />
                                                                    <Border Canvas.Left="12" Canvas.Top="44" Width="120" Height="6" CornerRadius="3"
                                                                            Background="{Binding LightBrush}" />
                                                                    <Border Canvas.Left="92" Canvas.Top="40" Width="5" Height="14" CornerRadius="3"
                                                                            Background="{Binding AccentBrush}" />
                                                                </Canvas>
                                                            </Panel>
                                                        </Border>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding Name}" />
                                                            <TextBlock Grid.Column="1" Classes="icon" FontSize="14" Text="{StaticResource IconCheck}"
                                                                       IsVisible="{Binding IsCurrent}" />
                                                        </Grid>
                                                        <TextBlock Classes="hint" FontSize="12" Text="{Binding Note}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Classes="glass" Padding="22,8">
                                <StackPanel>
                                    <Grid Classes="setting" ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="h3" Text="{res:Tr AnimatedBackgroundLabel}" />
                                            <TextBlock Classes="hint" Text="{res:Tr AnimatedBackgroundHint}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AnimatedBackground}"
                                                      AutomationProperties.Name="{res:Tr AnimatedBackgroundLabel}" />
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource YtLineBrush}" />
                                    <Grid Classes="setting" ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="h3" Text="{res:Tr ReduceMotionLabel}" />
                                            <TextBlock Classes="hint" Text="{res:Tr ReduceMotionHint}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ReduceMotion}"
                                                      AutomationProperties.Name="{res:Tr ReduceMotionLabel}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- General -->
                        <Border Classes="glass" Padding="22,8" IsVisible="{Binding IsGeneral}">
                            <StackPanel>
                                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="h3" Text="{res:Tr LanguageLabel}" />
                                        <TextBlock Classes="hint" Text="{res:Tr LanguageHint}" />
                                    </StackPanel>
                                    <!-- Language names stay in their own language, so anyone can find theirs. -->
                                    <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Classes="segment" Classes.chosen="{Binding IsEnglish}" Content="{res:Tr LanguageEnglish}"
                                                    Command="{Binding UseLanguageCommand}" CommandParameter="{x:Static res:Loc.English}" />
                                            <Button Classes="segment" Classes.chosen="{Binding IsFrench}" Content="{res:Tr LanguageFrench}"
                                                    Command="{Binding UseLanguageCommand}" CommandParameter="{x:Static res:Loc.French}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="{StaticResource YtLineBrush}" />
                                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="h3" Text="{res:Tr UpdatesLabel}" />
                                        <TextBlock Classes="hint" Text="{Binding UpdateResult}"
                                                   IsVisible="{Binding UpdateResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Content="{res:Tr CheckNow}"
                                            Command="{Binding CheckForUpdatesCommand}" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource YtLineBrush}" />
                                <Grid Classes="setting" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="h3" VerticalAlignment="Center" Text="{res:Tr CheckAtStartupLabel}" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckAtStartup}"
                                                  AutomationProperties.Name="{res:Tr CheckAtStartupLabel}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SettingsFile}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Panel>
</Window>
