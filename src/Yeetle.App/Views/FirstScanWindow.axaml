<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yeetle.App.ViewModels"
        xmlns:res="using:Yeetle.App.Resources"
        x:Class="Yeetle.App.Views.FirstScanWindow"
        x:DataType="vm:FirstScanViewModel"
        Title="{res:Tr FirstScanTitle}"
        Width="560" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark" Classes="dialog">
    <StackPanel Margin="28" Spacing="12">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <RadioButton GroupName="FirstScan" IsChecked="{Binding ReviewAll}" Content="{res:Tr FirstScanReviewAll}" />
        <RadioButton GroupName="FirstScan" IsChecked="{Binding KeepAll}" Content="{res:Tr FirstScanKeepAll}" />
        <RadioButton GroupName="FirstScan" IsChecked="{Binding ReviewFrom}">
            <TextBlock Text="{res:Tr FirstScanReviewFrom}" TextWrapping="Wrap" />
        </RadioButton>
        <CalendarDatePicker Margin="28,0,0,0" SelectedDate="{Binding FromDate}" IsEnabled="{Binding ReviewFrom}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" x:Name="CancelButton" Content="{res:Tr Cancel}" IsCancel="True" />
            <Button x:Name="ContinueButton" Content="{res:Tr Continue}" IsDefault="True" Classes="primary" />
        </StackPanel>
    </StackPanel>
</Window>
