<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Yeetle.App.ViewModels"
        xmlns:playback="using:Yeetle.Application.Playback"
        xmlns:res="using:Yeetle.App.Resources"
        xmlns:controls="using:Yeetle.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Yeetle.App.Views.VideoOverlayWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static res:Strings.AppTitle}"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        RequestedThemeVariant="Dark">
    <Window.Resources>
        <!-- Panels: a dark tint, about 70% opaque, readable over any picture. -->
        <SolidColorBrush x:Key="BlockBrush" Color="#B8101216" />
        <CornerRadius x:Key="BlockCornerRadius">10</CornerRadius>
        <!-- Decision colours: green keeps, red yeets, slate skips; each a shade lighter on hover. -->
        <SolidColorBrush x:Key="KeepBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="KeepHoverBrush" Color="#388E3C" />
        <SolidColorBrush x:Key="YeetBrush" Color="#C62828" />
        <SolidColorBrush x:Key="YeetHoverBrush" Color="#D32F2F" />
        <SolidColorBrush x:Key="SkipBrush" Color="#CC37474F" />
        <SolidColorBrush x:Key="SkipHoverBrush" Color="#455A64" />
        <!-- Marker ticks: amber, visible on the dark seek bar. -->
        <SolidColorBrush x:Key="MarkerBrush" Color="#F0B429" />
        <!-- The speed in use: the accent blue of the current clip card. -->
        <SolidColorBrush x:Key="CurrentSpeedBrush" Color="#2F6FD6" />
        <x:Double x:Key="SecondaryTextOpacity">0.75</x:Double>
        <x:Double x:Key="DisabledOpacity">0.4</x:Double>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.block">
            <Setter Property="Background" Value="{StaticResource BlockBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource BlockCornerRadius}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <!-- Buttons are for the mouse; keys are hotkeys. A focused button would also react to
             Space or Enter and fight the hotkey. -->
        <Style Selector="Button, ComboBox, Slider">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="{StaticResource SecondaryTextOpacity}" />
        </Style>
        <Style Selector="TextBlock.time">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas,monospace" />
            <Setter Property="MinWidth" Value="48" />
        </Style>
        <!-- Icon buttons of the control blocks; the play button is the largest, in the middle. -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon.main">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="42" />
        </Style>
        <Style Selector="Button.icon.main TextBlock.icon">
            <Setter Property="FontSize" Value="22" />
        </Style>
        <Style Selector="Button.speed">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Narrow enough that the sound block stays clear of the middle one at the default window size. -->
        <Style Selector="ComboBox.audio">
            <Setter Property="Width" Value="128" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="TextBlock.icon.label">
            <Setter Property="Opacity" Value="{StaticResource SecondaryTextOpacity}" />
        </Style>
        <!-- A marker tick: a short bright bar, wider when hovered. -->
        <Style Selector="Button.tick">
            <Setter Property="Width" Value="4" />
            <Setter Property="Height" Value="10" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="Button.tick /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource MarkerBrush}" />
        </Style>
        <Style Selector="Button.tick:pointerover">
            <Setter Property="Width" Value="6" />
        </Style>
        <!-- The speed button that matches the current speed. -->
        <Style Selector="Button.current /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CurrentSpeedBrush}" />
        </Style>

        <!-- Keep / Skip / Yeet: the review decisions, large and coloured. -->
        <Style Selector="Button.decision">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="{StaticResource BlockCornerRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.decision /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.keep /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KeepBrush}" />
        </Style>
        <Style Selector="Button.keep:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KeepHoverBrush}" />
        </Style>
        <Style Selector="Button.yeet /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource YeetBrush}" />
        </Style>
        <Style Selector="Button.yeet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource YeetHoverBrush}" />
        </Style>
        <Style Selector="Button.skip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SkipBrush}" />
        </Style>
        <Style Selector="Button.skip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SkipHoverBrush}" />
        </Style>
        <!-- The current decision of an opened clip. -->
        <Style Selector="Button.decision.current /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style Selector="Button.decision:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
        </Style>
    </Window.Styles>

    <Panel Margin="12">
        <!-- Top left: what is playing, and any message. -->
        <Border Classes="block" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="640"
                IsVisible="{Binding HasInfo}">
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Session.IsActive}">
                    <TextBlock FontWeight="Bold" Text="{Binding Session.Counter}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding Session.ClipName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Session.ClipDate}" Opacity="{StaticResource SecondaryTextOpacity}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsEditorPage}">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Editor.ClipName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Editor.ClipDate}" Opacity="{StaticResource SecondaryTextOpacity}" />
                </StackPanel>
                <TextBlock Text="{Binding Editor.Notice}" TextWrapping="Wrap" Opacity="{StaticResource SecondaryTextOpacity}"
                           IsVisible="{Binding Editor.Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding Player.Message}" TextWrapping="Wrap" Opacity="{StaticResource SecondaryTextOpacity}"
                           IsVisible="{Binding Player.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding Session.Notice}" TextWrapping="Wrap" Opacity="{StaticResource SecondaryTextOpacity}"
                           IsVisible="{Binding ShowSessionNotice}" />
                <TextBlock Text="{Binding ScanSummary}" TextWrapping="Wrap" Opacity="{StaticResource SecondaryTextOpacity}"
                           IsVisible="{Binding ScanSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Border>

        <!-- Bottom: the decision, then three small control blocks (sound, playback, speed), then the
             seek bar. Each block is its own tinted card, so most of the picture stays clear (#62). -->
        <StackPanel VerticalAlignment="Bottom" Spacing="10" IsVisible="{Binding ShowControls}">
            <!-- The decision for this clip: in a session, then for a clip opened from the Explorer,
                 where the current decision is outlined and there is no Skip (spec §8). -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" IsVisible="{Binding IsEditorPage}">
                <Button Classes="decision skip" Content="{x:Static res:Strings.BackToLibrary}" Command="{Binding Editor.CloseCommand}"
                        ToolTip.Tip="{x:Static res:Strings.BackToLibraryTip}" />
                <Button Classes="decision yeet" Classes.current="{Binding Editor.IsYeeted}" Content="{x:Static res:Strings.Yeet}"
                        Command="{Binding Editor.YeetCommand}" />
                <Button Classes="decision keep" Classes.current="{Binding Editor.IsKept}" Content="{x:Static res:Strings.Keep}"
                        Command="{Binding Editor.KeepCommand}" ToolTip.Tip="{x:Static res:Strings.EditorSavedHint}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" IsVisible="{Binding IsSessionPage}">
                <Button Classes="decision yeet" Content="{x:Static res:Strings.Yeet}" Command="{Binding Session.YeetCommand}"
                        ToolTip.Tip="{x:Static res:Strings.YeetTip}" />
                <Button Classes="decision skip" Content="{x:Static res:Strings.Skip}" Command="{Binding Session.SkipCommand}"
                        ToolTip.Tip="{x:Static res:Strings.SkipTip}" />
                <Button Classes="decision keep" Content="{x:Static res:Strings.Keep}" Command="{Binding Session.KeepCommand}"
                        ToolTip.Tip="{x:Static res:Strings.KeepTip}" />
            </StackPanel>

            <!-- Equal side columns keep the playback block in the exact middle, under Skip. -->
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                <!-- Left: how the clip sounds. -->
                <Border Grid.Column="0" Classes="block" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="icon" Command="{Binding Player.ToggleMuteCommand}" ToolTip.Tip="{Binding Player.MuteLabel}"
                                AutomationProperties.Name="{Binding Player.MuteLabel}" VerticalAlignment="Center">
                            <Panel>
                                <TextBlock Classes="icon" Text="{StaticResource IconVolume}" IsVisible="{Binding !Player.IsMuted}" />
                                <TextBlock Classes="icon" Text="{StaticResource IconMute}" IsVisible="{Binding Player.IsMuted}" />
                            </Panel>
                        </Button>
                        <Slider Width="72" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                Value="{Binding Player.Volume}" ToolTip.Tip="{x:Static res:Strings.Volume}"
                                AutomationProperties.Name="{x:Static res:Strings.Volume}" />
                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4"
                              VerticalAlignment="Center">
                            <TextBlock Classes="icon label" FontSize="14" Text="{StaticResource IconAudioTrack}"
                                       ToolTip.Tip="{x:Static res:Strings.AudioTrack}" />
                            <ComboBox Grid.Column="1" Classes="audio" ItemsSource="{Binding Player.AudioTracks}"
                                      SelectedItem="{Binding Player.SelectedAudioTrack}" ToolTip.Tip="{x:Static res:Strings.AudioTrack}"
                                      AutomationProperties.Name="{x:Static res:Strings.AudioTrack}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="playback:AudioTrack">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Classes="icon label" FontSize="14" Text="{StaticResource IconAudioOutput}"
                                       ToolTip.Tip="{x:Static res:Strings.AudioOutput}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Classes="audio" ItemsSource="{Binding Player.AudioDevices}"
                                      SelectedItem="{Binding Player.SelectedAudioDevice}" ToolTip.Tip="{x:Static res:Strings.AudioOutput}"
                                      AutomationProperties.Name="{x:Static res:Strings.AudioOutput}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="playback:AudioDevice">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Middle: undo, previous, play / pause, next, marker. -->
                <Border Grid.Column="1" Classes="block" VerticalAlignment="Bottom" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="icon" Command="{Binding Session.UndoCommand}" IsVisible="{Binding IsSessionPage}"
                                ToolTip.Tip="{x:Static res:Strings.UndoTip}" AutomationProperties.Name="{x:Static res:Strings.Undo}">
                            <TextBlock Classes="icon" Text="{StaticResource IconUndo}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding Editor.UndoCommand}" IsVisible="{Binding IsEditorPage}"
                                ToolTip.Tip="{x:Static res:Strings.UndoTip}" AutomationProperties.Name="{x:Static res:Strings.Undo}">
                            <TextBlock Classes="icon" Text="{StaticResource IconUndo}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding Session.BackCommand}" IsVisible="{Binding IsSessionPage}"
                                ToolTip.Tip="{x:Static res:Strings.BackTip}" AutomationProperties.Name="{x:Static res:Strings.Back}">
                            <TextBlock Classes="icon" Text="{StaticResource IconPrevious}" />
                        </Button>
                        <Button Classes="icon main" Command="{Binding Player.TogglePauseCommand}"
                                ToolTip.Tip="{Binding Player.PlayPauseLabel}" AutomationProperties.Name="{Binding Player.PlayPauseLabel}">
                            <Panel>
                                <TextBlock Classes="icon" Text="{StaticResource IconPause}" IsVisible="{Binding Player.IsPlaying}" />
                                <TextBlock Classes="icon" Text="{StaticResource IconPlay}" IsVisible="{Binding !Player.IsPlaying}" />
                            </Panel>
                        </Button>
                        <Button Classes="icon" Command="{Binding Session.SkipCommand}" IsVisible="{Binding IsSessionPage}"
                                ToolTip.Tip="{x:Static res:Strings.SkipTip}" AutomationProperties.Name="{x:Static res:Strings.Skip}">
                            <TextBlock Classes="icon" Text="{StaticResource IconNext}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding SideMarkers.AddCommand}"
                                ToolTip.Tip="{x:Static res:Strings.AddMarkerTip}" AutomationProperties.Name="{x:Static res:Strings.AddMarker}">
                            <TextBlock Classes="icon" Text="{StaticResource IconMarker}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right: speed and theatre mode. -->
                <Border Grid.Column="2" Classes="block" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ItemsControl ItemsSource="{Binding Player.Speeds}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpeedOptionViewModel">
                                    <Button Classes="speed" Content="{Binding Label}" Classes.current="{Binding IsCurrent}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Player.SetSpeedCommand}"
                                            CommandParameter="{Binding Speed}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="icon" Command="{Binding ToggleTheatreCommand}" Classes.current="{Binding IsTheatre}"
                                ToolTip.Tip="{x:Static res:Strings.TheatreTip}" AutomationProperties.Name="{x:Static res:Strings.Theatre}">
                            <TextBlock Classes="icon" Text="{StaticResource IconTheatre}" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Position, with the marker ticks just above the seek bar; hovering a tick shows its
                 label (spec §7). Same margin as the slider, so a tick sits where the thumb would. -->
            <Border Classes="block" Padding="12,4,12,6">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <ItemsControl Grid.Column="1" Margin="10,0" ItemsSource="{Binding SideMarkers.Ticks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:MarkerTickPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MarkerTick">
                                <Button Classes="tick" controls:MarkerTickPanel.Fraction="{Binding Fraction}"
                                        ToolTip.Tip="{Binding Tip}" Command="{Binding Seek}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="time" Text="{Binding Player.PositionText}" />
                    <Slider x:Name="SeekBar" Grid.Row="1" Grid.Column="1" Margin="10,0" Minimum="0"
                            Maximum="{Binding Player.SeekMaximum}" Value="{Binding Player.PositionSeconds}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="time" TextAlignment="Right"
                               Text="{Binding Player.DurationText}" />
                </Grid>
            </Border>
        </StackPanel>
    </Panel>
</Window>
