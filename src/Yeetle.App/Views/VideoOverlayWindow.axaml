<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Yeetle.App.ViewModels"
        xmlns:playback="using:Yeetle.Application.Playback"
        xmlns:res="using:Yeetle.App.Resources"
        xmlns:controls="using:Yeetle.App.Controls"
        xmlns:views="using:Yeetle.App.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Yeetle.App.Views.VideoOverlayWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{res:Tr AppTitle}"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        RequestedThemeVariant="Dark">
    <Window.Resources>
        <x:Double x:Key="SecondaryTextOpacity">0.75</x:Double>
        <!-- The speed dot: as tall as an icon button, round while closed. -->
        <x:Double x:Key="SpeedDotSize">38</x:Double>
        <CornerRadius x:Key="SpeedDotRadius">19</CornerRadius>
        <!-- Room left for the bottom controls, so reaching the speed block never opens the Tags panel. -->
        <Thickness x:Key="TagEdgeMargin">0,0,0,180</Thickness>
    </Window.Resources>

    <Window.Styles>
        <!-- Over the video: dark translucent blocks with a thin edge, no blur (#28). -->
        <Style Selector="Border.block">
            <Setter Property="Background" Value="{StaticResource YtOverlayBlockBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource YtCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource YtBlockRadius}" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <!-- Buttons are for the mouse; keys are hotkeys. A focused button would also react to
             Space or Enter and fight the hotkey. -->
        <Style Selector="Button, ComboBox, Slider">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="{StaticResource SecondaryTextOpacity}" />
        </Style>
        <Style Selector="TextBlock.time">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="44" />
        </Style>
        <Style Selector="Button.speed">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Narrow enough that the sound block stays clear of the middle one at the default window size. -->
        <Style Selector="ComboBox.audio">
            <Setter Property="Width" Value="128" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="TextBlock.icon.label">
            <Setter Property="Opacity" Value="{StaticResource SecondaryTextOpacity}" />
        </Style>
        <!-- A marker tick: a short bright bar, wider when hovered. -->
        <Style Selector="Button.tick">
            <Setter Property="Width" Value="4" />
            <Setter Property="Height" Value="10" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="Button.tick, Button.tick:pointerover">
            <Setter Property="Background" Value="{DynamicResource YtAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.tick:pointerover">
            <Setter Property="Width" Value="6" />
        </Style>

        <!-- The info and the controls fade out when the mouse rests over the video, and come back when it
             moves (#93). The root panel gets "idle"; the code-behind decides when. -->
        <Style Selector=":is(Control).chrome">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.idle :is(Control).chrome">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <!-- The sound and speed blocks show one icon; the rest opens while the pointer is on the block,
             or while one of its lists is open ("pinned"), and closes when it leaves (#93). -->
        <Style Selector=":is(Control).more">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.expandable:pointerover :is(Control).more, Border.expandable.pinned :is(Control).more">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Border.expandable:pointerover :is(Control).less, Border.expandable.pinned :is(Control).less">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- The speed dot (#94): a small circle with the speed in use; on hover it opens into a
             rounded bar of speed buttons. -->
        <Style Selector="Border.speedDot">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="{StaticResource SpeedDotSize}" />
            <Setter Property="Height" Value="{StaticResource SpeedDotSize}" />
            <Setter Property="CornerRadius" Value="{StaticResource SpeedDotRadius}" />
        </Style>
        <Style Selector="Border.speedDot:pointerover">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CornerRadius" Value="{StaticResource YtBlockRadius}" />
        </Style>
        <!-- The collapsed speed block: the speed in use, as large as an icon button (#93, #94). -->
        <Style Selector="TextBlock.speedNow">
            <Setter Property="MinWidth" Value="{StaticResource SpeedDotSize}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Theatre mode (#95): the clip's tags over the picture, as small chips with nothing behind them. -->
        <Style Selector="Button.tagChip">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="{StaticResource YtChipRadius}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource YtOverlayBlockBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource YtChipSelectedBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.tagChip:pointerover">
            <Setter Property="Background" Value="{DynamicResource YtPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- The full Tags panel, off to the right until the pointer reaches the edge of the video. -->
        <Style Selector="Border.drawer">
            <Setter Property="RenderTransform" Value="translateX(400px)" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.drawer.open">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
    </Window.Styles>

    <Panel>
    <!-- A short flash of the decision colour around the picture on Keep, Yeet and Skip (#69); none
         with Reduce motion. Drawn by the code-behind. -->
    <Border x:Name="Flash" Opacity="0" IsHitTestVisible="False" />
    <Panel x:Name="Root" Margin="12">
        <!-- Top left: what is playing, and any message. -->
        <Border Classes="block chrome" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="640"
                IsVisible="{Binding HasInfo}">
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Session.IsActive}">
                    <Border Classes="pill primary"><TextBlock FontSize="13" Text="{Binding Session.Counter}" /></Border>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Session.ClipName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Session.ClipDate}" Opacity="{StaticResource SecondaryTextOpacity}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsEditorPage}">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Editor.ClipName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Editor.ClipDate}" Opacity="{StaticResource SecondaryTextOpacity}" />
                </StackPanel>
                <TextBlock Text="{Binding Editor.Notice}" TextWrapping="Wrap" Opacity="{StaticResource SecondaryTextOpacity}"
                           IsVisible="{Binding Editor.Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding Player.Message}" TextWrapping="Wrap" Opacity="{StaticResource SecondaryTextOpacity}"
                           IsVisible="{Binding Player.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding Session.Notice}" TextWrapping="Wrap" Opacity="{StaticResource SecondaryTextOpacity}"
                           IsVisible="{Binding ShowSessionNotice}" />
                <TextBlock Text="{Binding ScanSummary}" TextWrapping="Wrap" Opacity="{StaticResource SecondaryTextOpacity}"
                           IsVisible="{Binding ScanSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Border>

        <!-- Bottom: the decision, then three small control blocks (sound, playback, speed), then the
             seek bar. Each block is its own tinted card, so most of the picture stays clear (#62). -->
        <StackPanel Classes="chrome" VerticalAlignment="Bottom" Spacing="10">
            <!-- The decision for this clip: in a session, then for a clip opened from the Explorer,
                 where the current decision is outlined and there is no Skip (spec §8). A clip whose
                 file is not on disk only keeps Back to library (#79). -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" IsVisible="{Binding IsEditorPage}">
                <Button Classes="skip" Content="{res:Tr BackToLibrary}" Command="{Binding Editor.CloseCommand}"
                        ToolTip.Tip="{res:Tr BackToLibraryTip}" />
                <Button Classes="yeet" Classes.current="{Binding Editor.IsYeeted}"
                        Command="{Binding Editor.YeetCommand}" IsVisible="{Binding ShowControls}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="icon" Foreground="White" Text="{StaticResource IconClose}" />
                            <TextBlock VerticalAlignment="Center" Text="{res:Tr Yeet}" />
                        </StackPanel>
                        </Button>
                <Button Classes="keep" Classes.current="{Binding Editor.IsKept}"
                        Command="{Binding Editor.KeepCommand}" ToolTip.Tip="{res:Tr EditorSavedHint}" IsVisible="{Binding ShowControls}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="icon" Foreground="White" Text="{StaticResource IconCheck}" />
                            <TextBlock VerticalAlignment="Center" Text="{res:Tr Keep}" />
                        </StackPanel>
                        </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" IsVisible="{Binding IsSessionPage}">
                <Button Classes="yeet" Command="{Binding Session.YeetCommand}" ToolTip.Tip="{res:Tr YeetTip}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="icon" Foreground="White" Text="{StaticResource IconClose}" />
                            <TextBlock VerticalAlignment="Center" Text="{res:Tr Yeet}" />
                        </StackPanel>
                        </Button>
                <Button Classes="skip" Command="{Binding Session.SkipCommand}" ToolTip.Tip="{res:Tr SkipTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="{res:Tr Skip}" />
                            <TextBlock Classes="icon" FontSize="13" Text="{StaticResource IconForward}" />
                        </StackPanel>
                        </Button>
                <Button Classes="keep" Command="{Binding Session.KeepCommand}" ToolTip.Tip="{res:Tr KeepTip}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="icon" Foreground="White" Text="{StaticResource IconCheck}" />
                            <TextBlock VerticalAlignment="Center" Text="{res:Tr Keep}" />
                        </StackPanel>
                        </Button>
            </StackPanel>

            <!-- Equal side columns keep the playback block in the exact middle, under Skip. -->
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" IsVisible="{Binding ShowControls}">
                <!-- Left: how the clip sounds. -->
                <!-- The side blocks sit on a canvas, so opening one grows it up over the picture without
                     moving the decision buttons (#93). -->
                <Canvas Grid.Column="0">
                <Border x:Name="SoundBlock" Classes="block expandable" Canvas.Left="0" Canvas.Bottom="0" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="iconButton bare" Command="{Binding Player.ToggleMuteCommand}" ToolTip.Tip="{Binding Player.MuteLabel}"
                                AutomationProperties.Name="{Binding Player.MuteLabel}" VerticalAlignment="Center">
                            <Panel>
                                <TextBlock Classes="icon" Text="{StaticResource IconVolume}" IsVisible="{Binding !Player.IsMuted}" />
                                <TextBlock Classes="icon" Text="{StaticResource IconMute}" IsVisible="{Binding Player.IsMuted}" />
                            </Panel>
                        </Button>
                        <StackPanel Classes="more" Orientation="Horizontal" Spacing="8">
                        <Slider Width="72" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                Value="{Binding Player.Volume}" ToolTip.Tip="{res:Tr Volume}"
                                AutomationProperties.Name="{res:Tr Volume}" />
                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4"
                              VerticalAlignment="Center">
                            <TextBlock Classes="icon label" FontSize="14" Text="{StaticResource IconAudioTrack}"
                                       ToolTip.Tip="{res:Tr AudioTrack}" />
                            <ComboBox x:Name="AudioTracks" Grid.Column="1" Classes="audio" ItemsSource="{Binding Player.AudioTracks}"
                                      SelectedItem="{Binding Player.SelectedAudioTrack}" ToolTip.Tip="{res:Tr AudioTrack}"
                                      AutomationProperties.Name="{res:Tr AudioTrack}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="playback:AudioTrack">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Classes="icon label" FontSize="14" Text="{StaticResource IconAudioOutput}"
                                       ToolTip.Tip="{res:Tr AudioOutput}" />
                            <ComboBox x:Name="AudioDevices" Grid.Row="1" Grid.Column="1" Classes="audio" ItemsSource="{Binding Player.AudioDevices}"
                                      SelectedItem="{Binding Player.SelectedAudioDevice}" ToolTip.Tip="{res:Tr AudioOutput}"
                                      AutomationProperties.Name="{res:Tr AudioOutput}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="playback:AudioDevice">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </Canvas>

                <!-- Middle: undo, previous, play / pause, next, marker. -->
                <Border Grid.Column="1" Classes="block" VerticalAlignment="Bottom" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="iconButton bare" Command="{Binding Session.UndoCommand}" IsVisible="{Binding IsSessionPage}"
                                ToolTip.Tip="{res:Tr UndoTip}" AutomationProperties.Name="{res:Tr Undo}">
                            <TextBlock Classes="icon" Text="{StaticResource IconUndo}" />
                        </Button>
                        <Button Classes="iconButton bare" Command="{Binding Editor.UndoCommand}" IsVisible="{Binding IsEditorPage}"
                                ToolTip.Tip="{res:Tr UndoTip}" AutomationProperties.Name="{res:Tr Undo}">
                            <TextBlock Classes="icon" Text="{StaticResource IconUndo}" />
                        </Button>
                        <Button Classes="iconButton bare" Command="{Binding Session.BackCommand}" IsVisible="{Binding IsSessionPage}"
                                ToolTip.Tip="{res:Tr BackTip}" AutomationProperties.Name="{res:Tr Back}">
                            <TextBlock Classes="icon" Text="{StaticResource IconPrevious}" />
                        </Button>
                        <Button Classes="iconButton round" Command="{Binding Player.TogglePauseCommand}"
                                ToolTip.Tip="{Binding Player.PlayPauseLabel}" AutomationProperties.Name="{Binding Player.PlayPauseLabel}">
                            <Panel>
                                <TextBlock Classes="icon" Text="{StaticResource IconPause}" IsVisible="{Binding Player.IsPlaying}" />
                                <TextBlock Classes="icon" Text="{StaticResource IconPlay}" IsVisible="{Binding !Player.IsPlaying}" />
                            </Panel>
                        </Button>
                        <Button Classes="iconButton bare" Command="{Binding Session.SkipCommand}" IsVisible="{Binding IsSessionPage}"
                                ToolTip.Tip="{res:Tr SkipTip}" AutomationProperties.Name="{res:Tr Skip}">
                            <TextBlock Classes="icon" Text="{StaticResource IconNext}" />
                        </Button>
                        <Button Classes="iconButton bare" Command="{Binding SideMarkers.AddCommand}"
                                ToolTip.Tip="{res:Tr AddMarkerTip}" AutomationProperties.Name="{res:Tr AddMarker}">
                            <TextBlock Classes="icon" Foreground="{DynamicResource YtAccentBrush}" Text="{StaticResource IconMarker}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right (decided in #94): a small dot with the speed in use, which opens to the speed
                     buttons on hover, then theatre mode as a plain button of its own. The dot grows to
                     the left, so the theatre button never moves. -->
                <Canvas Grid.Column="2">
                <StackPanel Canvas.Right="0" Canvas.Bottom="0" Orientation="Horizontal" Spacing="8">
                    <Border Classes="block expandable speedDot" VerticalAlignment="Center" ToolTip.Tip="{res:Tr SpeedBlockTip}">
                        <Panel>
                            <TextBlock Classes="less speedNow" Text="{Binding Player.SpeedLabel}" />
                            <ItemsControl Classes="more" ItemsSource="{Binding Player.Speeds}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SpeedOptionViewModel">
                                        <Button Classes="segment speed" Content="{Binding Label}" Classes.chosen="{Binding IsCurrent}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Player.SetSpeedCommand}"
                                                CommandParameter="{Binding Speed}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Panel>
                    </Border>
                    <Border Classes="block" Padding="4">
                        <Button Classes="iconButton bare" Command="{Binding ToggleTheatreCommand}" Classes.current="{Binding IsTheatre}"
                                ToolTip.Tip="{res:Tr TheatreTip}" AutomationProperties.Name="{res:Tr Theatre}">
                            <TextBlock Classes="icon" Text="{StaticResource IconTheatre}" />
                        </Button>
                    </Border>
                </StackPanel>
                </Canvas>
            </Grid>

            <!-- Position, with the marker ticks just above the seek bar; hovering a tick shows its
                 label (spec §7). Same margin as the slider, so a tick sits where the thumb would. -->
            <Border Classes="block" Padding="12,4,12,6" IsVisible="{Binding ShowControls}">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <ItemsControl Grid.Column="1" Margin="10,0" ItemsSource="{Binding SideMarkers.Ticks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:MarkerTickPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MarkerTick">
                                <Button Classes="tick" controls:MarkerTickPanel.Fraction="{Binding Fraction}"
                                        ToolTip.Tip="{Binding Tip}" Command="{Binding Seek}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="time" Text="{Binding Player.PositionText}" />
                    <Slider x:Name="SeekBar" Grid.Row="1" Grid.Column="1" Margin="10,0" Minimum="0"
                            Maximum="{Binding Player.SeekMaximum}" Value="{Binding Player.PositionSeconds}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="time" TextAlignment="Right"
                               Text="{Binding Player.DurationText}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Theatre mode (#95). The right tenth of the video, above the bottom controls, opens the
             full Tags panel; the clip's tags stay listed at the top right meanwhile. -->
        <Grid ColumnDefinitions="9*,*" Margin="{StaticResource TagEdgeMargin}"
              IsVisible="{Binding ShowTheatreTags}">
            <Border x:Name="TagEdge" Grid.Column="1" Background="Transparent" />
        </Grid>
        <ItemsControl ItemsSource="{Binding SideTags.SelectedChips}" HorizontalAlignment="Right" VerticalAlignment="Top"
                      IsVisible="{Binding ShowTheatreTags}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChipViewModel">
                    <Button Classes="tagChip" Command="{Binding Toggle}" ToolTip.Tip="{res:Tr RemoveTagTip}"
                            AutomationProperties.Name="{Binding Name}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding ColourBrush}"
                                     IsVisible="{Binding HasColour}" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="TagDrawer" Classes="drawer" Width="360" HorizontalAlignment="Right"
                IsVisible="{Binding ShowTheatreTags}">
            <views:TagsPanel DataContext="{Binding SideTags}" />
        </Border>
    </Panel>
    </Panel>
</Window>
