<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yeetle.App.ViewModels"
        xmlns:res="using:Yeetle.App.Resources"
        x:Class="Yeetle.App.Views.FileResultsWindow"
        x:DataType="vm:FileResultsViewModel"
        Title="{Binding Title}"
        Width="640" SizeToContent="Height" MaxHeight="640"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark">
    <Window.Resources>
        <SolidColorBrush x:Key="FailureBrush" Color="#FF9A92" />
        <x:Double x:Key="SecondaryTextOpacity">0.7</x:Double>
    </Window.Resources>

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" Text="{Binding Title}" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Command="{Binding ShowInFolderCommand}" IsVisible="{Binding CanShowInFolder}"
                    AutomationProperties.Name="{x:Static res:Strings.ShowInFolder}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" FontSize="14" Text="{StaticResource IconFolder}" />
                    <TextBlock Text="{x:Static res:Strings.ShowInFolder}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="RestoreButton" Content="{x:Static res:Strings.RestoreOriginalNames}" IsVisible="{Binding CanRestoreNames}"
                    ToolTip.Tip="{x:Static res:Strings.RestoreOriginalNamesTip}" />
            <Button x:Name="CloseButton" Classes="accent" Content="{x:Static res:Strings.Close}" IsCancel="True" IsDefault="True" />
        </StackPanel>
        <!-- Each failure in plain language, file by file (spec §9). -->
        <ScrollViewer IsVisible="{Binding HasFailures}">
            <ItemsControl ItemsSource="{Binding Failures}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FailedFileViewModel">
                        <StackPanel Margin="0,4">
                            <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="{StaticResource FailureBrush}" Text="{Binding Reason}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
