<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yeetle.App.ViewModels"
        xmlns:res="using:Yeetle.App.Resources"
        xmlns:controls="using:Yeetle.App.Controls"
        x:Class="Yeetle.App.Views.TagManagerWindow"
        x:DataType="vm:TagManagerViewModel"
        Title="{res:Tr TagManagerTitle}"
        Width="1120" Height="740" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark">
    <!-- Layout decided in #9 (spec §6), look from ZiL's canvas (#69): nested box cards on the left, the
         selection on the right. -->
    <Window.Resources>
        <SolidColorBrush x:Key="NoticeBrush" Color="#1F0A59F7" />
        <x:Double x:Key="DotSize">10</x:Double>
        <x:Double x:Key="SwatchSize">30</x:Double>
        <!-- Boxes under a tag are indented below it. -->
        <Thickness x:Key="NestedIndent">28,0,0,0</Thickness>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource YtCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource YtCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource YtCardRadius}" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style Selector="Border.card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource YtRowSelectedBorderBrush}" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0,10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <!-- The box title: a click selects the box. -->
        <Style Selector="Button.plain">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.plain:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource YtTextBrush}" />
        </Style>
        <Style Selector="Button.plain:pointerover /template/ Border#RootBorder">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <!-- "+ Tag": a dashed-looking ghost, in the light theme colour. -->
        <Style Selector="Button.addTag">
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource YtControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource YtPrimaryLightBrush}" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource YtTextMutedBrush}" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <!-- A box card. Its tags with boxes below them repeat this template, nested. -->
        <DataTemplate DataType="vm:BoxCardViewModel" x:DataType="vm:BoxCardViewModel">
            <Border Classes="card" Classes.selected="{Binding IsSelected}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                        <Button Classes="plain" Command="{Binding Select}" HorizontalAlignment="Left"
                                ToolTip.Tip="{res:Tr SelectBoxTip}">
                            <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Title}" TextWrapping="Wrap" />
                        </Button>
                        <!-- An unnamed box is always pick many and never required (spec §6). -->
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsPickOne}" VerticalAlignment="Center" IsVisible="{Binding IsNamed}"
                                      OnContent="{res:Tr RulePickOne}"
                                      OffContent="{res:Tr RulePickMany}" />
                        <CheckBox Grid.Column="2" IsChecked="{Binding IsRequired}" VerticalAlignment="Center" IsVisible="{Binding IsNamed}"
                                  Content="{res:Tr Required}" ToolTip.Tip="{res:Tr RequiredTip}" />
                    </Grid>
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TagNodeViewModel">
                                    <Button Classes="chip" Classes.selected="{Binding IsSelected}" Command="{Binding Select}"
                                            AutomationProperties.Name="{Binding Name}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="{StaticResource DotSize}" Height="{StaticResource DotSize}"
                                                     Fill="{Binding ColourBrush}" IsVisible="{Binding HasColour}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <Border Classes="key" IsVisible="{Binding HasHotkey}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Hotkey}" />
                                            </Border>
                                            <!-- Boxes under this tag: a click opens them below the card (#81). -->
                                            <TextBlock Text="{Binding ExpandGlyph}" IsVisible="{Binding HasBoxes}" VerticalAlignment="Center"
                                                       Classes="secondary" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="ghost small addTag" Content="{res:Tr AddTag}" Command="{Binding AddTag}" />
                    </WrapPanel>
                    <!-- The boxes under the selected tag (or above the selection), nested (#81). -->
                    <ItemsControl ItemsSource="{Binding OpenBoxes}" Margin="{StaticResource NestedIndent}"
                                  IsVisible="{Binding HasOpenBoxes}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
    <controls:GlowBackground />
    <Grid ColumnDefinitions="*,400" ColumnSpacing="20" Margin="24">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="logo">
                        <TextBlock Classes="icon" Foreground="White" Text="{StaticResource IconTag}" />
                    </Border>
                    <TextBlock FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Text="{res:Tr TagManagerTitle}" />
                </StackPanel>
                <TextBlock Classes="hint" Margin="0,4,0,0" Text="{res:Tr TagManagerHint}" />
                <!-- The user's tags file, editable outside Yeetle (spec §6). -->
                <WrapPanel Margin="0,6,0,0" ItemSpacing="8" LineSpacing="6">
                    <Button Classes="ghost small" Content="{res:Tr OpenTagFile}" Command="{Binding OpenTagFileCommand}"
                            ToolTip.Tip="{res:Tr TagFileHint}" />
                    <Button Classes="ghost small" Content="{res:Tr ImportTagFile}" Command="{Binding ImportTagFileCommand}"
                            ToolTip.Tip="{res:Tr TagFileHint}" />
                </WrapPanel>
                <TextBlock Text="{Binding TagFileMessage}" TextWrapping="Wrap"
                           IsVisible="{Binding TagFileMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <!-- Text typed in the session's tag box that matched nothing (spec §6). -->
            <Border DockPanel.Dock="Top" Background="{StaticResource NoticeBrush}" CornerRadius="{StaticResource YtBlockRadius}" Padding="14,10"
                    Margin="0,0,0,12" IsVisible="{Binding HasPendingName}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding PendingNameHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost small" Content="{res:Tr Cancel}" Command="{Binding CancelPendingNameCommand}" />
                </Grid>
            </Border>
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="{res:Tr NoTagsInManager}" TextWrapping="Wrap" Margin="0,0,0,12"
                               IsVisible="{Binding IsEmpty}" Classes="hint" />
                    <!-- Placeholder cards until the tags are read (#78). -->
                    <StackPanel Spacing="12" IsVisible="{Binding !IsLoaded}">
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <Border Classes="skeleton" Width="140" Height="16" />
                                <Border Classes="skeleton" Width="420" Height="24" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <Border Classes="skeleton" Width="110" Height="16" />
                                <Border Classes="skeleton" Width="300" Height="24" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Boxes}" />
                    <Button Classes="primary" Content="{res:Tr AddTopLevelBox}" Command="{Binding AddTopLevelBoxCommand}"
                            IsVisible="{Binding IsLoaded}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- The selected tag or box. -->
        <Border Grid.Column="1" Classes="glass" Padding="22" VerticalAlignment="Top">
            <ScrollViewer>
                <StackPanel Spacing="6">
                    <TextBlock Classes="hint" Text="{res:Tr SelectSomething}" IsVisible="{Binding !HasSelection}" />
                    <StackPanel Spacing="6" IsVisible="{Binding HasSelection}">
                        <TextBlock Classes="muted" Text="{Binding SelectedPath}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{res:Tr NameLabel}" IsVisible="{Binding CanRename}" />
                        <TextBox x:Name="NameBox" Text="{Binding EditName}" IsVisible="{Binding CanRename}" />

                        <StackPanel Spacing="6" IsVisible="{Binding HasTagSelected}">
                            <TextBlock Classes="caption" Text="{res:Tr ColourLabel}" />
                            <ItemsControl ItemsSource="{Binding Colours}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ColourChoice">
                                        <Button Classes="plain" Margin="0,0,4,4" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}"
                                                Command="{Binding $parent[Window].((vm:TagManagerViewModel)DataContext).SetColourCommand}"
                                                CommandParameter="{Binding}">
                                            <Panel Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}">
                                                <Ellipse Fill="{Binding Brush}" Stroke="{StaticResource YtControlBorderBrush}" StrokeThickness="1" />
                                                <TextBlock Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           IsVisible="{Binding Brush, Converter={x:Static ObjectConverters.IsNull}}" />
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="caption" Text="{res:Tr HotkeyLabel}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="key" VerticalAlignment="Center" Padding="10,3">
                                    <TextBlock FontSize="15" Text="{Binding SelectedHotkey}" />
                                </Border>
                                <Button Classes="ghost small" Content="{res:Tr ChangeHotkey}" Command="{Binding StartHotkeyCaptureCommand}" />
                                <Button Classes="ghost small" Content="{res:Tr RemoveHotkey}" Command="{Binding ClearHotkeyCommand}" />
                            </StackPanel>
                            <TextBlock Text="{res:Tr PressAKey}" TextWrapping="Wrap" FontWeight="SemiBold"
                                       IsVisible="{Binding IsCapturingHotkey}" />

                            <TextBlock Classes="caption" Text="{res:Tr UsageLabel}" />
                            <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding ClipCountText}" />
                            <TextBlock Classes="caption" Text="{res:Tr FileNameFormLabel}" />
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource YtTagPillTextBrush}" Text="{Binding FileNameForm}" TextWrapping="Wrap" />

                            <TextBlock Classes="caption" Text="{res:Tr BelowThisTag}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="ghost small" Content="{res:Tr AddBoxUnder}" Command="{Binding AddBoxUnderSelectedCommand}"
                                        ToolTip.Tip="{res:Tr AddBoxUnderTip}" />
                                <Button Classes="ghost small" Content="{res:Tr AddTagUnder}" Command="{Binding AddTagUnderSelectedCommand}"
                                        ToolTip.Tip="{res:Tr AddTagUnderTip}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Classes="caption" Text="{res:Tr OrderLabel}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="ghost small" Content="{res:Tr MoveUp}" Command="{Binding MoveUpCommand}" />
                            <Button Classes="ghost small" Content="{res:Tr MoveDown}" Command="{Binding MoveDownCommand}" />
                        </StackPanel>
                        <TextBlock Classes="hint" FontSize="12" Text="{res:Tr OrderHint}" />

                        <Button Classes="danger" HorizontalAlignment="Left" Margin="0,16,0,0" Content="{res:Tr Delete}"
                                Command="{Binding DeleteSelectedCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{StaticResource YtDangerTextBrush}"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
    </Panel>
</Window>
