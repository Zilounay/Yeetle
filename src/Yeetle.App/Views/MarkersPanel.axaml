<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yeetle.App.ViewModels"
             xmlns:res="using:Yeetle.App.Resources"
             x:Class="Yeetle.App.Views.MarkersPanel"
             x:DataType="vm:MarkersPanelViewModel"
             Focusable="True" FocusAdorner="{x:Null}">
    <UserControl.Styles>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <!-- The time of a marker: a small pill in the marker colour; clicking it seeks there. -->
        <Style Selector="Button.time">
            <Setter Property="Background" Value="{DynamicResource YtAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource YtAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource YtSmallRadius}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.time:pointerover">
            <Setter Property="Background" Value="{DynamicResource YtAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource YtTextBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- The markers of the current clip, under the tags (spec §7, layout from #9). -->
    <Border Classes="glass">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <TextBlock Classes="h2" VerticalAlignment="Center" Text="{res:Tr Markers}" />
                <Button Grid.Column="1" Classes="ghost small" Command="{Binding AddCommand}" ToolTip.Tip="{res:Tr AddMarkerTip}"
                        AutomationProperties.Name="{res:Tr AddMarker}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{res:Tr AddMarker}" />
                        <Border Classes="key"><TextBlock Text="K" /></Border>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Text="{res:Tr NoMarkersYet}" TextWrapping="Wrap"
                       Classes="hint" IsVisible="{Binding IsEmpty}" />
            <ScrollViewer>
                <ItemsControl x:Name="List" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MarkerItemViewModel">
                            <Border Classes="tile" Margin="0,0,0,8" Padding="8,6">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                <Button Classes="small time" Content="{Binding TimeText}"
                                        Command="{Binding Seek}" ToolTip.Tip="{res:Tr SeekToMarkerTip}" />
                                <TextBox Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="iconButton bare" Content="⤓" Command="{Binding MoveHere}"
                                        ToolTip.Tip="{res:Tr MoveMarkerHereTip}" />
                                <Button Grid.Column="3" Classes="iconButton bare" Content="×" Command="{Binding Delete}"
                                        ToolTip.Tip="{res:Tr DeleteMarkerTip}" />
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
