<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yeetle.App.ViewModels"
             xmlns:res="using:Yeetle.App.Resources"
             x:Class="Yeetle.App.Views.MarkersPanel"
             x:DataType="vm:MarkersPanelViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#15181D" />
        <SolidColorBrush x:Key="PanelLineBrush" Color="#23272E" />
        <SolidColorBrush x:Key="KeyBrush" Color="#24FFFFFF" />
        <x:Double x:Key="SecondaryTextOpacity">0.7</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.key">
            <Setter Property="Background" Value="{StaticResource KeyBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1" />
        </Style>
    </UserControl.Styles>

    <!-- The markers of the current clip, under the tags (spec §7, layout from #9). -->
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelLineBrush}" BorderThickness="1"
            CornerRadius="12" Padding="14">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Text="{x:Static res:Strings.Markers}" />
                <Button Grid.Column="1" Command="{Binding AddCommand}" ToolTip.Tip="{x:Static res:Strings.AddMarkerTip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Static res:Strings.AddMarker}" />
                        <Border Classes="key"><TextBlock FontSize="11" Text="K" /></Border>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.NoMarkersYet}" TextWrapping="Wrap"
                       Opacity="{StaticResource SecondaryTextOpacity}" IsVisible="{Binding IsEmpty}" />
            <ScrollViewer>
                <ItemsControl x:Name="List" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MarkerItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4" Margin="0,0,0,6">
                                <Button Classes="small" FontFamily="Consolas,monospace" Content="{Binding TimeText}"
                                        Command="{Binding Seek}" ToolTip.Tip="{x:Static res:Strings.SeekToMarkerTip}" />
                                <TextBox Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="small" Content="⤓" Command="{Binding MoveHere}"
                                        ToolTip.Tip="{x:Static res:Strings.MoveMarkerHereTip}" />
                                <Button Grid.Column="3" Classes="small" Content="×" Command="{Binding Delete}"
                                        ToolTip.Tip="{x:Static res:Strings.DeleteMarkerTip}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
