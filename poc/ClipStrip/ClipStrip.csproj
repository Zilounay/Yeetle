<Project Sdk="Microsoft.NET.Sdk">

  <!-- POC for issue #5: throwaway, never referenced by Yeetle.slnx. It reuses the app's player and
       overlay as they are, and adds the thumbnail strip and the FFmpeg calls under test. -->

  <PropertyGroup>
    <!-- A console app, so the benchmark mode can print its table; the window works the same. -->
    <OutputType>Exe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yeetle.App\Yeetle.App.csproj" />
    <ProjectReference Include="..\..\src\Yeetle.Application\Yeetle.Application.csproj" />
    <ProjectReference Include="..\..\src\Yeetle.Infrastructure\Yeetle.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Yeetle.Media\Yeetle.Media.csproj" />
  </ItemGroup>

</Project>
